---
import { showToolsSection } from "../data/tools";

const { showSectionLinks = true } = Astro.props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@800&text=invisilab&display=swap" />

<style>
  /* Wordmark: "invisi" fades in like something becoming visible, "lab" stays solid */
  .brand-wordmark {
    font-family: "Syne", "SF Pro Display", "Helvetica Neue", sans-serif;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.045em;
    line-height: 1;
    gap: 0;
    opacity: 1;
  }

  .brand-invisi {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, currentColor 22%, transparent),
      currentColor 92%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    padding-bottom: 0.08em;
  }

  .brand-wordmark:hover .brand-invisi {
    background: currentColor;
    -webkit-background-clip: text;
    background-clip: text;
  }
</style>

<nav>
  <div class="nav-content">
    <div class="nav-left">
      <a href="/" class="nav-logo brand-wordmark" aria-label="invisilab">
        <span class="brand-invisi" aria-hidden="true">invisi</span><span class="brand-lab" aria-hidden="true">lab</span>
      </a>

      {
        showSectionLinks && showToolsSection && (
          <div class="nav-links">
            <a href="#tools" data-i18n="nav_tools">Tools</a>
          </div>
        )
      }
    </div>

    <div class="nav-right">
      <div class="lang-selector">
        <button class="lang-btn" aria-label="Change Language">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </button>
        <div class="lang-dropdown">
          <button data-lang="zh-CN">简体中文</button>
          <button data-lang="zh-TW">繁體中文</button>
          <button data-lang="en">English</button>
        </div>
      </div>

      <button class="theme-toggle" aria-label="Toggle Dark Mode">
        <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>
