---
import { languageFor, languageLinks as linksFor } from "../i18n/site";
import { showToolsSection } from "../data/tools";
import AppSwitcher from "./AppSwitcher.astro";
import { apps } from "../data/apps";
import { basePath } from "../i18n/site";

const { showSectionLinks = true, languageLinks = linksFor(Astro.url.pathname) } = Astro.props as {
  showSectionLinks?: boolean;
  languageLinks?: readonly { lang: string; label: string; path: string }[];
};
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@800&text=invisilab&display=swap" />

<style>
  .brand-wordmark {
    font-family: "Syne", "SF Pro Display", "Helvetica Neue", sans-serif;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.045em;
    line-height: 1;
    gap: 0;
    opacity: 1;
    /* The wordmark is two spans; keep their order on right-to-left pages. */
    direction: ltr;
  }

  .brand-invisi {
    padding-bottom: 0.08em;
  }

  :global(.lang-dropdown) {
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 160ms ease, transform 160ms ease, display 160ms allow-discrete;
  }
  :global(.lang-dropdown.show) { opacity: 1; transform: translateY(0); }
  @starting-style {
    :global(.lang-dropdown.show) { opacity: 0; transform: translateY(-4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.lang-dropdown) { transition: none; transform: none; }
  }
</style>

<nav class="main-nav">
  <div class="nav-content">
    <div class="nav-left">
      <a href="/" class="nav-logo brand-wordmark" aria-label="invisilab">
        <span class="brand-invisi" aria-hidden="true">invisi</span><span class="brand-lab" aria-hidden="true">lab</span>
      </a>

      {
        showSectionLinks && showToolsSection && (
          <div class="nav-links">
            <a href="#tools" data-i18n="nav_tools">Tools</a>
          </div>
        )
      }
    </div>

    <div class="nav-right">
      {apps.some(app => basePath(Astro.url.pathname) === `/${app.slug}/`) && <AppSwitcher />}
      <div class="lang-selector">
        <button class="lang-btn" aria-label="Change Language">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </button>
        <div class="lang-dropdown">
          {languageLinks ? languageLinks.map(locale => <a href={locale.path} hreflang={locale.lang} lang={locale.lang} aria-current={locale.lang === languageFor(Astro.url.pathname) ? "page" : undefined}>{locale.label}</a>) : <>
            <button data-lang="zh-CN">简体中文</button>
            <button data-lang="zh-TW">繁體中文</button>
            <button data-lang="en">English</button>
          </>}
        </div>
      </div>

      <button class="theme-toggle" aria-label="Toggle Dark Mode">
        <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  const languageMenu = document.querySelector<HTMLElement>('.lang-selector');
  const appMenu = document.querySelector<HTMLDetailsElement>('.app-switcher');
  const languagePanel = languageMenu?.querySelector('.lang-dropdown');
  const closeMenus = () => {
    languagePanel?.classList.remove('show');
    if (appMenu) appMenu.open = false;
  };
  let closeTimer: ReturnType<typeof setTimeout>;
  for (const menu of [languageMenu, appMenu]) {
    menu?.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'mouse') return;
      clearTimeout(closeTimer);
      closeMenus();
      if (menu === appMenu && appMenu) appMenu.open = true;
      else languagePanel?.classList.add('show');
    });
    menu?.addEventListener('pointerleave', event => {
      if (event.pointerType === 'mouse') closeTimer = setTimeout(closeMenus, 180);
    });
  }
</script>
