---
import { languageFor, localizedPath } from "../i18n/site";
import { pick } from "../i18n/translate";
import { tools } from "../data/tools";
import { sharedDictionary } from "../i18n/dictionaries";
const lang = languageFor(Astro.url.pathname);
---

<footer>
  <div class="footer-inner-container">
    <div class="footer-directory" role="navigation" aria-label="产品与使用指南">
      <div class="footer-column">
        <h3><a href="/apps/">全部应用</a></h3>
        <a href="/nexpaste/">NexPaste</a>
        <a href="/transnap/">Transnap</a>
        <a href="/invsi/">invsi</a>
        <a href="/pixie-wallpaper/">精灵壁纸</a>
        <a href="/pineapple-english/">菠萝英语</a>
        <a href="/are-you-ok/">Are You OK</a>
      </div>
      <div class="footer-column">
        <h3>更多工具</h3>
        <div class="footer-tools">
          {tools.map(tool => (
            <a href={tool.href} data-i18n={tool.titleKey}>
              {sharedDictionary["zh-CN"][tool.titleKey as keyof typeof sharedDictionary["zh-CN"]]}
            </a>
          ))}
        </div>
      </div>
      <div class="footer-column">
        <h3>invisilab</h3>
        <a href={localizedPath('/about/', lang)}>{pick(lang, { 'zh-CN': '关于我', 'zh-TW': '關於我', en: 'About me' })}</a>
      </div>
      <div class="footer-column">
        <h3>使用指南</h3>
        <a href="/guides/">所有指南</a>
      </div>
    </div>
    <div class="footer-content" style="margin-top: 15px; padding-top: 0; justify-content: flex-start;">
      <div class="footer-legal">
        <a href="/user-agreement" class="footer-links" style="color: inherit; opacity: 0.8; font-size: 11px;" data-i18n="user_agreement">User Agreement</a>
        <span style="opacity: 0.4">|</span>
        <a href="/privacy-policy" class="footer-links" style="color: inherit; opacity: 0.8; font-size: 11px;" data-i18n="privacy_policy">Privacy Policy</a>
        <span style="opacity: 0.4">|</span>
        <a href="/terms-of-use" class="footer-links" style="color: inherit; opacity: 0.8; font-size: 11px;" data-i18n="terms_of_use">Terms of Use</a>
      </div>
    </div>
    <div class="footer-content" style="margin-top: 12px;">
      <div class="copyright">Copyright © 2026 invisilab. All rights reserved.</div>
      <div class="footer-links">
        <a href="https://www.xiaohongshu.com/user/profile/5777e1583460946ad6894dc4" target="_blank" rel="noopener noreferrer" data-i18n="footer_xhs">Xiaohongshu</a>
        <a href="https://x.com/invisilab_x" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter) @invisilab_x">X</a>
        <a
          href="#"
          rel="nofollow"
          onclick="window.location.href='mailto:'+['deepseals','icloud.com'].join(String.fromCharCode(64));return false;"
          data-i18n="footer_contact"
          >Contact Us</a
        >
      </div>
    </div>
  </div>
</footer>



<style>
  .footer-directory { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.4fr) minmax(0,.8fr) minmax(0,.8fr); column-gap:clamp(20px,4vw,48px); row-gap:28px; align-items:start; padding-bottom:32px; margin-bottom:20px; border-bottom:1px solid var(--border-color); text-align:left; }
  .footer-tools { display:flex; flex-direction:column; align-items:flex-start; gap:10px; }
  .footer-column { min-width:0; display:flex; flex-direction:column; align-items:flex-start; gap:10px; }
  .footer-column h3 { margin:0 0 2px; font-size:12px; font-weight:600; color:var(--text-primary); }
  .footer-column a { font-size:12px; line-height:1.5; color:inherit; text-decoration:none; }
  .footer-column a:hover { text-decoration:underline; }
  @media (max-width:700px) {
    .footer-directory { grid-template-columns:repeat(2,minmax(0,1fr)); gap:28px 20px; }
  }
</style>
