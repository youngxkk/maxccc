---
import ProductDetails from "../components/ProductDetails.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import MainFooter from "../components/MainFooter.astro";
import MainNav from "../components/MainNav.astro";

const appStoreUrl = "https://apps.apple.com/app/id6762361410";
const sourceUrl = "https://github.com/youngxkk/transnap-oss";
---

<BaseLayout
  title="Transnap - macOS Menu Bar Translation"
  description="Transnap is a menu bar translation app for macOS. Copy text, translate quickly, and keep history on your Mac."
  canonical="https://maxc.cc/transnap/"
  ogImage="https://maxc.cc/images/transnap-icon.png"
  includeHomeStyles={true}
  includeHomeScript={true}
>
  <MainNav showSectionLinks={false} />

  <main class="transnap-page" id="top">
    <div class="mouse-glow"></div>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy fade-up-entry">
        <img class="hero-icon" src="/images/transnap-icon.png" alt="Transnap App Icon" />
        <p class="eyebrow" data-i18n="transnap_eyebrow">为 macOS 菜单栏而生</p>
        <h1 id="hero-title">Transnap</h1>
        <p class="hero-lede" data-i18n="transnap_hero_lede">复制一下，马上翻译。</p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button primary" href={appStoreUrl} target="_blank" rel="noopener noreferrer" data-i18n="app_store">App Store</a>
          <a class="button secondary" href={sourceUrl} target="_blank" rel="noopener noreferrer" data-i18n="transnap_open_source">GitHub 开源</a>
        </div>
      </div>

      <div class="hero-visual fade-up-entry" aria-label="Transnap interface preview">
        <div class="tn-desk">
          <div class="tn-menubar" aria-hidden="true">
            <span class="tn-apple"></span>
            <span class="tn-menubar-right">
              <i class="tn-status active">
                <img src="/images/transnap-icon.png" alt="" />
              </i>
              <i></i>
              <i></i>
              <b>9:41</b>
            </span>
          </div>

          <div class="tn-panel">
            <div class="tn-head">
              <strong><img src="/images/transnap-icon.png" alt="" />Transnap</strong>
              <span class="tn-icons" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" stroke-linecap="round" /></svg>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5" /><path d="m9 9 6 6m0-6-6 6" /></svg>
              </span>
            </div>
            <div class="tn-status-row">
              <span data-i18n="transnap_ui_status">本地翻译 · 英语 → 中文</span>
              <span class="tn-lang"><b data-i18n="transnap_auto_detect">自动检测</b> → <b data-i18n="transnap_chinese">中文</b></span>
            </div>
            <div class="tn-input">Translate without breaking your flow. Copy a sentence, and it’s already here.</div>
            <div class="tn-actions">
              <span class="tn-translate" data-i18n="transnap_ui_translate">翻译</span>
              <span class="tn-copy" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="8" width="12" height="12" rx="2.5" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
              </span>
            </div>
            <div class="tn-result" data-i18n="transnap_preview_translation">翻译，不打断你的状态。复制一句话，它已经在这里了。</div>
            <span class="tn-handle" aria-hidden="true"></span>
          </div>

          <div class="floating-card">
            <strong>⌘ ⇧ C</strong>
            <span data-i18n="transnap_shortcut_caption">唤起窗口。立即翻译。</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section gray" id="features">
      <div class="section-inner">
        <div class="center-heading fade-up-entry">
          <h2 data-i18n="transnap_features_title">小到不打扰。</h2>
          <p class="section-lede" data-i18n="transnap_features_lede">菜单栏里的轻量翻译。</p>
        </div>

        <div class="feature-showcase">
          <article class="tile large fade-up-entry">
            <h3 data-i18n="transnap_feature_copy">复制即翻。</h3>
            <div class="clipboard-demo" aria-hidden="true">
              <div class="demo-line"></div>
              <div class="demo-line"></div>
              <div class="demo-line"></div>
            </div>
          </article>

          <article class="tile dark fade-up-entry">
            <h3 data-i18n="transnap_feature_shortcut">快捷键唤起。</h3>
            <div class="shortcut-keys" aria-hidden="true">
              <span class="key">⌘</span>
              <span class="key">⇧</span>
              <span class="key">C</span>
            </div>
          </article>

          <article class="tile fade-up-entry" id="privacy">
            <h3 data-i18n="transnap_feature_privacy">历史留在本机。</h3>
            <div class="privacy-rings" aria-hidden="true">
              <span class="ring"></span>
              <span class="ring"></span>
              <span class="ring">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                  <path d="M12 3 5 6.5V12c0 4.4 2.9 7.2 7 8.5 4.1-1.3 7-4.1 7-8.5V6.5L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                  <path d="m9 12 2 2 4-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </article>

          <article class="tile large fade-up-entry">
            <h3 data-i18n="transnap_feature_system">使用 macOS 系统翻译能力。</h3>
          </article>
        </div>
      </div>
    </section>

    <section class="section white" id="languages">
      <div class="section-inner language-stage">
        <div class="language-copy fade-up-entry">
          <h2 data-i18n="transnap_language_title">只自动识别你的主要语言。</h2>
          <p data-i18n="transnap_language_desc">选择两种常用语言。其它语言，手动指定。</p>
        </div>

        <div class="settings-card fade-up-entry" aria-label="Language settings preview">
          <div class="settings-head">
            <span data-i18n="transnap_language_setting">自动识别主要语言</span>
            <span data-i18n="transnap_settings">设置</span>
          </div>
          <div class="setting-box">
            <div class="choice">
              <small data-i18n="transnap_my_language">我的语言</small>
              <strong data-i18n="transnap_chinese">中文</strong>
            </div>
            <svg class="swap-icon" width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M7 7h10m0 0-3-3m3 3-3 3M17 17H7m0 0 3-3m-3 3 3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="choice">
              <small data-i18n="transnap_common_language">常用互译语言</small>
              <strong>English</strong>
            </div>
          </div>
          <ul class="manual-list">
            <li><strong data-i18n="transnap_pair_cn_en">中文 ↔ English</strong><span data-i18n="transnap_auto_detect_short">自动识别</span></li>
            <li><strong>日本語</strong><span data-i18n="transnap_manual_select">手动选择</span></li>
            <li><strong>한국어</strong><span data-i18n="transnap_manual_select">手动选择</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="download" id="download">
      <img src="/images/transnap-icon.png" alt="Transnap App Icon" />
      <h2 data-i18n="transnap_download_title">把翻译放进菜单栏。</h2>
      <p data-i18n="transnap_download_desc">从 App Store 免费获取 Transnap。翻译在本机完成，无需账号，不上传文本。现已开源，可在 GitHub 查看源码。</p>
      <div class="download-buttons">
        <a class="button primary" href={appStoreUrl} target="_blank" rel="noopener noreferrer" data-i18n="app_store">App Store</a>
        <a class="button secondary" href={sourceUrl} target="_blank" rel="noopener noreferrer" data-i18n="transnap_open_source">GitHub 开源</a>
        <a class="button secondary" href="/privacy-policy/" data-i18n="privacy_policy">隐私政策</a>
      </div>
    </section>
  <ProductDetails slug="transnap" />
  </main>

  <MainFooter />

  <style>
    .transnap-page {
      color: #1d1d1f;
      background: #fbfbfd;
      overflow-x: hidden;
    }

    :global(:root:not([data-theme="light"])) .transnap-page {
      color: #f5f5f7;
      background: #000;
    }

    .hero {
      position: relative;
      overflow: hidden;
      min-height: 100vh;
      padding: 128px 24px 54px;
      text-align: center;
      background:
        radial-gradient(circle at 50% 18%, rgba(0, 113, 227, 0.12), transparent 34%),
        linear-gradient(180deg, #fff 0%, #fbfbfd 48%, #f5f5f7 100%);
    }

    :global(:root:not([data-theme="light"])) .hero {
      background:
        radial-gradient(circle at 50% 18%, rgba(0, 113, 227, 0.2), transparent 34%),
        linear-gradient(180deg, #09090b 0%, #000 52%, #111113 100%);
    }

    .hero-copy {
      width: min(940px, 100%);
      margin: 0 auto;
    }

    .hero-icon {
      width: 92px;
      height: 92px;
      margin: 0 auto 28px;
      border-radius: 22px;
      box-shadow: 0 20px 44px rgba(0, 0, 0, 0.16);
    }

    .eyebrow {
      margin: 0 0 10px;
      color: #86868b;
      font-size: 21px;
      line-height: 1.2;
      font-weight: 600;
    }

    .hero h1,
    .section h2,
    .tile h3,
    .download h2,
    .transnap-page p {
      margin: 0;
      letter-spacing: 0;
    }

    .hero h1 {
      font-size: clamp(58px, 9vw, 112px);
      line-height: 0.94;
      font-weight: 700;
      color: #1d1d1f;
    }

    :global(:root:not([data-theme="light"])) .hero h1 {
      color: #f5f5f7;
    }

    .hero-lede {
      max-width: 800px;
      margin: 22px auto 0;
      color: #6e6e73;
      font-size: clamp(23px, 3vw, 32px);
      line-height: 1.22;
      font-weight: 600;
    }

    .hero-actions,
    .download-buttons {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
      margin-top: 32px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0 22px;
      border-radius: 999px;
      font-size: 17px;
      font-weight: 600;
      text-decoration: none;
    }

    .button.primary {
      color: #fff;
      background: #0071e3;
    }

    .button.primary:hover {
      background: #0077ed;
    }

    .button.secondary {
      color: #0071e3;
      background: transparent;
    }

    .hero-visual {
      position: relative;
      width: min(780px, 100%);
      height: 610px;
      margin: 58px auto 0;
    }


    .tn-desk {
      position: relative;
      width: min(900px, 100%);
      height: 560px;
      margin: 0 auto;
      overflow: hidden;
      border-radius: 26px;
      background:
        radial-gradient(ellipse at 15% 10%, #ffd9a8 0%, transparent 45%),
        radial-gradient(ellipse at 90% 30%, #a8c8ff 0%, transparent 50%),
        radial-gradient(ellipse at 50% 100%, #ffc2d9 0%, transparent 55%),
        linear-gradient(135deg, #fff1df, #e3ecff 60%, #ffe3ef);
      box-shadow: 0 40px 100px rgba(0, 0, 0, 0.18);
      text-align: left;
    }

    :global(:root:not([data-theme="light"])) .tn-desk {
      background:
        radial-gradient(ellipse at 15% 10%, #5a3a1a 0%, transparent 45%),
        radial-gradient(ellipse at 90% 30%, #1a3a7a 0%, transparent 50%),
        radial-gradient(ellipse at 50% 100%, #5a1a3a 0%, transparent 55%),
        linear-gradient(135deg, #1b140f, #0e1426 60%, #1f0e18);
      box-shadow: 0 40px 100px rgba(0, 0, 0, 0.6);
    }

    .tn-menubar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 28px;
      padding: 0 18px;
      background: rgba(255, 255, 255, 0.35);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      color: rgba(0, 0, 0, 0.78);
      font-size: 12.5px;
    }

    :global(:root:not([data-theme="light"])) .tn-menubar {
      background: rgba(0, 0, 0, 0.3);
      color: rgba(255, 255, 255, 0.88);
    }

    .tn-apple {
      width: 12px;
      height: 14px;
      border-radius: 50% 50% 45% 45%;
      background: currentColor;
    }

    .tn-menubar-right {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .tn-menubar-right i {
      width: 14px;
      height: 11px;
      border: 1.5px solid currentColor;
      border-radius: 3px;
      opacity: 0.8;
    }

    .tn-menubar-right i.tn-status {
      display: grid;
      place-items: center;
      width: 26px;
      height: 22px;
      border: 0;
      border-radius: 6px;
      background: rgba(0, 0, 0, 0.12);
      opacity: 1;
    }

    .tn-menubar-right i.tn-status img {
      width: 15px;
      height: 15px;
      border-radius: 4px;
    }

    .tn-panel {
      position: absolute;
      top: 38px;
      right: 120px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 360px;
      padding: 14px 14px 26px;
      border-radius: 18px;
      background: rgba(250, 250, 252, 0.72);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.9),
        inset 0 0 0 0.5px rgba(0, 0, 0, 0.08),
        0 24px 60px rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(30px) saturate(180%);
      -webkit-backdrop-filter: blur(30px) saturate(180%);
      color: #1d1d1f;
    }

    :global(:root:not([data-theme="light"])) .tn-panel {
      background: rgba(36, 36, 40, 0.7);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.14),
        inset 0 0 0 0.5px rgba(255, 255, 255, 0.1),
        0 24px 60px rgba(0, 0, 0, 0.5);
      color: #f5f5f7;
    }

    .tn-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .tn-head strong {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: ui-rounded, "SF Pro Rounded", -apple-system, sans-serif;
      font-size: 19px;
      font-weight: 600;
    }

    .tn-head strong img {
      width: 22px;
      height: 22px;
      border-radius: 6px;
    }

    .tn-icons {
      display: flex;
      gap: 12px;
      opacity: 0.7;
    }

    .tn-status-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: -6px;
      color: #6e6e73;
      font-size: 12.5px;
    }

    :global(:root:not([data-theme="light"])) .tn-status-row {
      color: #a1a1a6;
    }

    .tn-lang {
      flex: 0 0 auto;
      font-size: 12px;
    }

    .tn-lang b {
      padding: 3px 8px;
      border-radius: 7px;
      background: rgba(120, 120, 128, 0.16);
      color: inherit;
      font-weight: 600;
    }

    .tn-input,
    .tn-result {
      padding: 11px 12px;
      font-size: 14px;
      line-height: 1.45;
    }

    .tn-input {
      min-height: 96px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.6);
    }

    .tn-result {
      min-height: 96px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.4);
    }

    :global(:root:not([data-theme="light"])) .tn-input {
      background: rgba(255, 255, 255, 0.08);
    }

    :global(:root:not([data-theme="light"])) .tn-result {
      background: rgba(255, 255, 255, 0.12);
    }

    .tn-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .tn-translate {
      padding: 6px 16px;
      border-radius: 999px;
      background: rgba(0, 122, 255, 0.88);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16), 0 2px 6px rgba(0, 122, 255, 0.2);
      color: #fff;
      font-size: 13px;
      font-weight: 600;
    }

    .tn-copy {
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: rgba(120, 120, 128, 0.16);
    }

    .tn-handle {
      position: absolute;
      left: 50%;
      bottom: 8px;
      width: 52px;
      height: 5px;
      transform: translateX(-50%);
      border-radius: 999px;
      background: rgba(120, 120, 128, 0.3);
    }

    .tn-desk .floating-card {
      position: absolute;
      left: 60px;
      bottom: 60px;
    }

    @media (max-width: 860px) {
      .tn-desk {
        height: 520px;
      }

      .tn-panel {
        left: 50%;
        right: auto;
        width: min(340px, calc(100% - 24px));
        transform: translateX(-50%);
      }

      .tn-desk .floating-card {
        display: none;
      }
    }

    .floating-card {
      position: absolute;
      right: 0;
      bottom: 8px;
      width: min(340px, calc(100% - 36px));
      padding: 18px 20px;
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.76);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
      text-align: left;
      backdrop-filter: blur(28px) saturate(180%);
    }

    :global(:root:not([data-theme="light"])) .floating-card {
      border-color: rgba(255, 255, 255, 0.1);
      background: rgba(28, 28, 30, 0.76);
    }

    .floating-card strong {
      display: block;
      margin-bottom: 4px;
      font-size: 17px;
    }

    .floating-card span {
      color: #6e6e73;
      font-size: 14px;
      line-height: 1.42;
    }

    .section {
      padding: 120px 24px;
    }

    .section.white {
      background: #fff;
    }

    .section.gray {
      background: #f5f5f7;
    }

    :global(:root:not([data-theme="light"])) .section.white,
    :global(:root:not([data-theme="light"])) .section.gray {
      background: #0f0f11;
    }

    .section-inner {
      width: min(980px, 100%);
      margin: 0 auto;
    }

    .center-heading {
      max-width: 820px;
      margin: 0 auto 58px;
      text-align: center;
    }

    .section h2,
    .download h2 {
      font-size: clamp(42px, 6vw, 72px);
      line-height: 1.03;
      font-weight: 700;
    }

    .section-lede {
      margin-top: 18px;
      color: #6e6e73;
      font-size: clamp(20px, 2.4vw, 28px);
      line-height: 1.28;
      font-weight: 600;
    }

    .feature-showcase {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    .tile {
      min-height: 300px;
      padding: 28px;
      overflow: hidden;
      border-radius: 28px;
      background: #fff;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
    }

    :global(:root:not([data-theme="light"])) .tile {
      background: #1c1c1e;
    }

    .tile.large {
      grid-column: span 2;
    }

    .tile.dark {
      color: #f5f5f7;
      background: #1d1d1f;
    }

    .tile h3 {
      max-width: 440px;
      font-size: 32px;
      line-height: 1.08;
      font-weight: 700;
    }

    .clipboard-demo {
      margin-top: 42px;
      padding: 22px;
      border-radius: 18px;
      background: #f5f5f7;
    }

    :global(:root:not([data-theme="light"])) .clipboard-demo {
      background: rgba(255, 255, 255, 0.08);
    }

    .demo-line {
      height: 13px;
      margin-bottom: 12px;
      border-radius: 999px;
      background: #d2d2d7;
    }

    .demo-line:nth-child(1) {
      width: 94%;
    }

    .demo-line:nth-child(2) {
      width: 78%;
    }

    .demo-line:nth-child(3) {
      width: 58%;
      margin-bottom: 0;
      background: #0071e3;
    }

    .shortcut-keys {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 54px;
    }

    .key {
      display: grid;
      min-width: 58px;
      height: 52px;
      place-items: center;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      color: #f5f5f7;
      background: rgba(255, 255, 255, 0.08);
      box-shadow: inset 0 -2px 0 rgba(255, 255, 255, 0.08);
      font-size: 15px;
      font-weight: 700;
    }

    .privacy-rings {
      position: relative;
      height: 170px;
      margin-top: 64px;
    }

    .ring {
      position: absolute;
      inset: 0;
      margin: auto;
      border: 2px solid rgba(0, 113, 227, 0.18);
      border-radius: 50%;
    }

    .ring:nth-child(1) {
      width: 170px;
      height: 170px;
    }

    .ring:nth-child(2) {
      width: 118px;
