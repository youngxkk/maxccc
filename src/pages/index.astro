---
import MainFooter from "../components/MainFooter.astro";
import MainNav from "../components/MainNav.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sharedDictionary } from "../i18n/dictionaries";
import { apps } from "../data/apps";
import { showToolsSection, tools } from "../data/tools";
---

<BaseLayout
  title="invisilab - Mac、iPhone 与 iPad 独立应用"
  description="invisilab 为 Mac、iPhone 和 iPad 打造无广告应用：NexPaste 剪贴板、Transnap 翻译、invsi 私密空间、精灵壁纸、菠萝英语和 Are You OK。"
  canonical="https://maxc.cc/"
  includeHomeStyles={true}
  includeHomeScript={true}
  includeFirebaseAuth={true}
>
  <div class="mouse-glow"></div>

  <MainNav />

  <div class="container">
    <header class="hero">
      <h1 data-i18n="hero_title">做点有意思的。</h1>
      <p data-i18n="hero_desc">
        把有意思的想法，做成真正好用的 App。<br />
        不放广告，不拿体验换收益。
      </p>
    </header>

    <div id="apps" class="grid">
      {
        apps.filter((app) => !app.hidden).map((app) => (
          <div class="card fade-up-entry">
            <a href={`/${app.slug}`} class="card-link-overlay" aria-label={`了解 ${app.name}`}></a>
            <div class="app-icon">
              <img src={app.image} alt={app.imageAlt} />
            </div>
            {
              app.titleKey ? (
                <h2 class="card-title" data-i18n={app.titleKey} style="margin:0">{app.name}</h2>
              ) : (
                <h2 class="card-title" style="margin:0">{app.name}</h2>
              )
            }
            <div class="card-desc" data-i18n={app.descriptionKey}>{sharedDictionary["zh-CN"][app.descriptionKey as keyof typeof sharedDictionary["zh-CN"]]}</div>
            <a href={app.href} target="_blank" rel="noopener noreferrer" class="card-btn" data-i18n="app_store">App Store</a>
          </div>
        ))
      }
    </div>

    {
      showToolsSection && (
        <>
        <header class="section-header fade-up-entry" style="text-align: center; margin-bottom: 40px; margin-top: 80px;">
          <h2 style="font-size: 32px; font-weight: 700;" data-i18n="nav_tools">实用工具</h2>
        </header>

        <div id="tools" class="tools-grid">
          {
            tools.map((tool) => (
              <a href={tool.href} class="card-horizontal fade-up-entry">
                <div class="app-icon" style={tool.icon ? "background: #f3f4f6; display: flex; align-items: center; justify-content: center; font-size: 32px;" : undefined}>
                  {tool.image ? <img src={tool.image} alt={tool.imageAlt || ""} /> : tool.icon}
                </div>
                <div class="card-info">
                  <div class="card-title" data-i18n={tool.titleKey}></div>
                  <div class="card-desc" data-i18n={tool.descriptionKey}></div>
                </div>
              </a>
            ))
          }
        </div>
        </>
      )
    }
  </div>

  <MainFooter />
</BaseLayout>
