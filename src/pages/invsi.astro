---
import ProductDetails from "../components/ProductDetails.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import MainNav from '../components/MainNav.astro';
import MainFooter from '../components/MainFooter.astro';
import StoreButton from '../components/mock/StoreButton.astro';
import Artwork from '../components/InvsiArtwork.astro';
import { invsiContent } from '../i18n/invsi-content';
const t = (key: keyof typeof invsiContent['zh-CN']) => invsiContent['zh-CN'][key];
const appStoreUrl = 'https://apps.apple.com/app/id6444667120';
const gallery = [
  { name: 'home', title: 'iv_private_title', desc: 'iv_private_desc', alt: 'invsi private photos, videos and files' },
  { name: 'apps', title: 'iv_apps_title', desc: 'iv_apps_desc', alt: 'invsi App Lock' },
  { name: 'calculator', title: 'iv_calc_title', desc: 'iv_calc_desc', alt: 'invsi calculator passcode entrance' },
  { name: 'focus', title: 'iv_focus_title', desc: 'iv_focus_desc', alt: 'invsi focus timer entrance' },
] as const;
---
<BaseLayout title="invsi — Your Own Private Space" description="照片、视频、文件，都收好。用应用锁和计算器、专注计时器专属入口，为隐私留出自己的空间。" canonical="https://maxc.cc/invsi" ogImage="https://maxc.cc/images/invsi/screen-home.webp" includeHomeStyles includeHomeScript>
  <MainNav showSectionLinks={false} />
  <main class="invsi">


    <section class="iv-hero" id="overview">
      <div class="hero-copy">
        <p class="eyebrow" data-i18n="iv_eyebrow">{t('iv_eyebrow')}</p>
        <h1 data-i18n="iv_title" set:html={t('iv_title')} />
        <p class="lede" data-i18n="iv_intro" set:html={t('iv_intro')} />
        <StoreButton href={appStoreUrl} />
        <p class="availability" data-i18n="iv_available">{t('iv_available')}</p>
      </div>
      <div class="hero-art" aria-label="invsi device mockups">
        <div class="hero-orbit" aria-hidden="true"></div>
        <div class="hero-poster back"><Artwork name="focus" alt="invsi focus timer" eager /></div>
        <div class="hero-poster front"><Artwork name="private" alt="invsi private space" eager /></div>
        <span class="hero-caption" data-i18n="iv_motto">{t('iv_motto')}</span>
      </div>
      <a class="explore" href="#features"><span data-i18n="iv_explore">{t('iv_explore')}</span><span aria-hidden="true">↓</span></a>
    </section>

    <section class="statement wrap" id="features">
      <p class="section-label" data-i18n="iv_statement_label">{t('iv_statement_label')}</p>
      <h2 data-i18n="iv_statement" set:html={t('iv_statement')} />
      <p data-i18n="iv_statement_desc" set:html={t('iv_statement_desc')} />
    </section>

    <section class="feature wrap private">
      <div class="feature-art cyan"><Artwork name="home" alt="Passcode protected private space in invsi" /></div>
      <div class="feature-copy"><p class="eyebrow" data-i18n="iv_private">{t('iv_private')}</p><h2 data-i18n="iv_private_title" set:html={t('iv_private_title')} /><p data-i18n="iv_private_desc">{t('iv_private_desc')}</p><div class="file-types"><span aria-hidden="true">▧ &nbsp; ▷ &nbsp; ▤</span><span data-i18n="iv_types">{t('iv_types')}</span></div></div>
    </section>

    <section class="feature wrap apps">
      <div class="feature-copy"><p class="eyebrow" data-i18n="iv_apps">{t('iv_apps')}</p><h2 data-i18n="iv_apps_title" set:html={t('iv_apps_title')} /><p data-i18n="iv_apps_desc">{t('iv_apps_desc')}</p><small data-i18n="iv_apps_note">{t('iv_apps_note')}</small></div>
      <div class="feature-art peach"><Artwork name="apps" alt="Choose which apps to lock with invsi" /></div>
    </section>

    <section class="entrances wrap">
      <div class="section-heading"><p class="eyebrow" data-i18n="iv_entrances">{t('iv_entrances')}</p><h2 data-i18n="iv_entrances_title" set:html={t('iv_entrances_title')} /><p data-i18n="iv_entrances_desc">{t('iv_entrances_desc')}</p></div>
      <div class="entrance-grid">
        <article class="entrance calculator"><div class="entrance-copy"><span class="entrance-number" data-i18n="iv_calc_label">{t('iv_calc_label')}</span><h3 data-i18n="iv_calc_title">{t('iv_calc_title')}</h3><p data-i18n="iv_calc_desc">{t('iv_calc_desc')}</p></div><Artwork name="calculator" alt="Calculator with a private passcode entrance" /></article>
        <article class="entrance focus"><div class="entrance-copy"><span class="entrance-number" data-i18n="iv_focus_label">{t('iv_focus_label')}</span><h3 data-i18n="iv_focus_title">{t('iv_focus_title')}</h3><p data-i18n="iv_focus_desc">{t('iv_focus_desc')}</p></div><Artwork name="focus" alt="Focus timer with a private passcode entrance" /></article>
      </div>
    </section>

    <section class="gallery-section" id="gallery">
      <div class="gallery-heading wrap"><div><p class="eyebrow" data-i18n="iv_gallery_label">{t('iv_gallery_label')}</p><h2 data-i18n="iv_gallery_title">{t('iv_gallery_title')}</h2><p data-i18n="iv_gallery_desc">{t('iv_gallery_desc')}</p></div><div class="gallery-controls"><button type="button" data-direction="-1" aria-label="Previous image"><span aria-hidden="true">←</span></button><button type="button" data-direction="1" aria-label="Next image"><span aria-hidden="true">→</span></button></div></div>
      <div class="gallery-track" tabindex="0" role="region" aria-label="invsi screenshots">{gallery.map(({name,alt,title,desc}, i) => <figure><figcaption><span class="gallery-number">0{i + 1}</span><h3 data-i18n={title} set:html={t(title)} /><p data-i18n={desc}>{t(desc)}</p></figcaption><div class:list={["gallery-device", name]}><Artwork name={name} alt={alt} /></div></figure>)}</div>
    </section>

    <section class="ipad-section wrap"><div class="section-heading"><p class="eyebrow">INVSI / WIDE VIEW</p><h2 data-i18n="iv_ipad_title" set:html={t('iv_ipad_title')} /><p data-i18n="iv_ipad_desc">{t('iv_ipad_desc')}</p></div><div class="ipad-art"><Artwork name="wide" alt="invsi private space on a larger display" /></div></section>
    <section class="download wrap"><img src="/images/invis.webp" width="80" height="80" alt="invsi app icon" /><p class="wordmark">invsi</p><h2 data-i18n="iv_download_title" set:html={t('iv_download_title')} /><p data-i18n="iv_download_desc">{t('iv_download_desc')}</p><StoreButton href={appStoreUrl} /><a class="privacy-link" href="/privacy-policy/" data-i18n="privacy_policy">隐私政策</a></section>
    <ProductDetails slug="invsi" />
  </main>
  <MainFooter />
</BaseLayout>
<script>
  const track = document.querySelector<HTMLElement>('.gallery-track');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.gallery-controls button');
  const update = () => {
    if (!track) return;
    buttons[0].disabled = track.scrollLeft < 4;
    buttons[1].disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    const en = document.documentElement.lang.startsWith('en');
    const tw = document.documentElement.lang === 'zh-TW';
    buttons[0].setAttribute('aria-label', en ? 'Previous image' : tw ? '上一張' : '上一张');
    buttons[1].setAttribute('aria-label', en ? 'Next image' : tw ? '下一張' : '下一张');
  };
  buttons.forEach(button => button.addEventListener('click', () => {
    if (!track) return;
    const width = track.querySelector('figure')?.getBoundingClientRect().width || 300;
    track.scrollBy({left: Number(button.dataset.direction) * (width + 24), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
  }));
  track?.addEventListener('scroll', update, {passive:true});
  window.addEventListener('resize', update);
  new MutationObserver(update).observe(document.documentElement, {attributes:true,attributeFilter:['lang']});
  update();
</script>
<style>
  .invsi { --ink:#153a36; --muted:#647974; --mint:#12bca6; padding-top:48px; background:#fbfdfb; color:var(--ink); overflow:clip; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif; }
  .invsi a { text-decoration:none; }
  .wrap { width:min(1160px,calc(100% - 96px)); margin-inline:auto; }
  .iv-hero { text-align:left; position:relative; min-height:830px; display:grid; grid-template-columns:1fr 1fr; align-items:center; padding:65px max(48px,calc((100% - 1160px)/2)) 105px; background:radial-gradient(ellipse at 80% 36%,#cff6e9 0,transparent 54%),#f3f8f1; }
  .eyebrow,.section-label { font-size:11px; font-weight:700; letter-spacing:2px; line-height:1.7; }
  .iv-hero h1 { font-size:clamp(56px,6.2vw,88px); letter-spacing:-5px; line-height:1.13; font-weight:750; margin:24px 0; }
  .lede { color:var(--muted); font-size:18px; line-height:1.9; margin-bottom:32px; }
  .invsi :global(.pp-store) { display:inline-flex; align-items:center; justify-content:center; gap:10px; padding:16px 24px; border-radius:40px; background:var(--ink); color:#fff; font-size:14px; font-weight:650; transition:transform .2s,background .2s; }
  .invsi :global(.pp-store:hover) { background:#20665b; transform:translateY(-2px); }
  .invsi :global(.pp-store svg) { width:23px; height:23px; fill:currentColor; }
  .availability { margin-top:15px; font-size:11px; color:var(--muted); }
  .hero-art { position:relative; height:610px; margin-left:15px; }
  .hero-orbit { position:absolute; width:510px; height:510px; border:1px solid #a5d4c5; border-radius:50%; top:60px; left:0; }
  .hero-orbit::after { content:''; position:absolute; inset:30px; border:1px solid #bce2d5; border-radius:50%; }
  .hero-poster { position:absolute; width:240px; filter:drop-shadow(0 25px 24px #1b635d28); }
  .hero-poster.front { top:15px; left:30px; transform:rotate(-9deg); z-index:2; }
  .hero-poster.back { top:92px; left:242px; transform:rotate(10deg); }
  .hero-caption { position:absolute; right:0; bottom:0; font-size:10px; letter-spacing:2px; color:#517a6d; }
  .explore { position:absolute; bottom:30px; left:max(48px,calc((100% - 1160px)/2)); right:max(48px,calc((100% - 1160px)/2)); display:flex; justify-content:space-between; align-items:center; padding-top:20px; border-top:1px solid #cbded2; color:var(--ink); font-size:12px; }
  .explore>span:last-child { font-size:24px; }
  h2 { font-size:clamp(38px,4.5vw,62px); line-height:1.2; letter-spacing:-2.8px; font-weight:700; }
  .statement { text-align:center; padding-block:125px 110px; }
  .section-label { color:#81978d; margin-bottom:22px; }
  .statement>p:last-child { color:var(--muted); font-size:18px; line-height:1.9; margin-top:24px; }
  .feature { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:100px; margin-bottom:70px; }
  .feature-art { height:600px; border-radius:30px; overflow:hidden; display:flex; justify-content:center; padding-block:35px; }
  .feature-art :global(picture) { width:250px; flex-shrink:0; align-self:center; }
  .cyan { background:#e2f6f8; } .peach { background:#fbecdf; }
  .feature-copy h2 { margin:20px 0 25px; }
  .feature-copy>p:not(.eyebrow) { font-size:17px; color:var(--muted); line-height:1.9; max-width:390px; }
  .feature-copy .eyebrow { color:#558275; }
  .feature-copy small { display:block; color:var(--muted); font-size:11px; margin-top:28px; }
  .file-types { display:flex; flex-direction:column; gap:15px; margin-top:32px; font-size:13px; color:#3b7a76; }
  .file-types>span:first-child { font-size:27px; }
  .entrances { padding-top:65px; padding-bottom:115px; }
  .section-heading { text-align:center; }
  .section-heading h2 { margin:20px 0 24px; }
  .section-heading>p:last-child { max-width:560px; margin-inline:auto; font-size:17px; line-height:1.8; color:var(--muted); }
  .entrance-grid { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:52px; }
  .entrance { border-radius:28px; height:700px; overflow:hidden; }
  .calculator { background:#14262b; color:#eef9f7; } .focus { background:#f0e8f4; }
  .entrance-copy { padding:40px 40px 0; }
  .entrance-number { font-size:10px; letter-spacing:2px; opacity:.6; }
  h3 { font-size:28px; line-height:1.3; letter-spacing:-1px; margin:17px 0 12px; }
  .entrance-copy p { font-size:14px; opacity:.65; }
  .entrance :global(picture) { width:230px; margin:35px auto 0; }
  .gallery-section { padding:90px 0; background:#edf3ec; }
  .gallery-heading { display:flex; align-items:end; justify-content:space-between; gap:24px; }
  .gallery-heading h2 { font-size:42px; margin:15px 0; }
  .gallery-heading p:last-child { color:var(--muted); font-size:15px; }
  .gallery-controls { display:flex; gap:10px; }
  .gallery-controls button { width:44px; height:44px; border:1px solid #b3c9bf; background:transparent; border-radius:50%; color:var(--ink); cursor:pointer; font-size:20px; }
  .gallery-controls button:disabled { opacity:.3; cursor:default; }
  .gallery-track { display:flex; gap:24px; overflow-x:auto; scroll-snap-type:x mandatory; padding:45px max(48px,calc((100% - 1160px)/2)) 20px; scrollbar-width:thin; scrollbar-color:#9bb7aa transparent; }
  .gallery-track figure { display:grid; grid-template-rows:1fr auto; width:340px; flex-shrink:0; scroll-snap-align:center; }
  .gallery-device { height:560px; border-radius:24px; display:flex; justify-content:center; align-items:center; padding:30px; background:#e2f6f8; }
  .gallery-device.apps { background:#fbecdf; }
  .gallery-device :global(picture) { width:230px; flex-shrink:0; }
  figcaption { min-height:220px; padding:0 10px 24px; }
  .gallery-number { font-size:11px; letter-spacing:2px; color:var(--muted); }
  figcaption h3 { font-size:27px; margin:14px 0; }
  figcaption p { font-size:14px; color:var(--muted); line-height:1.7; }
  .ipad-section { padding-top:110px; }
  .ipad-art { margin:45px auto 60px; max-width:900px; padding:40px; background:#e2f6f8; border-radius:28px; }
  .download { text-align:center; padding:110px 0; border-top:1px solid #dce7df; }
  .download>img { border-radius:20px; box-shadow:0 10px 24px #208b7c15; }
  .wordmark { font-size:23px; font-weight:700; margin-top:12px; letter-spacing:-1px; }
  .download h2 { margin:28px 0 20px; }
  .download>p:not(.wordmark) { color:var(--muted); font-size:16px; margin-bottom:28px; line-height:1.8; }
  .privacy-link { display:block; width:fit-content; margin:22px auto 0; color:var(--muted); font-size:12px; }
  a:focus-visible,button:focus-visible,.gallery-track:focus-visible { outline:3px solid #00ac91; outline-offset:5px; }
  @media(min-width:1600px) { .iv-hero { min-height:890px; } }
  @media(max-width:1100px) { .hero-poster { width:210px; } .hero-poster.back { left:195px; } .hero-art { height:560px; } .hero-orbit { width:420px;height:420px; } .feature { gap:55px; } .iv-hero h1 { letter-spacing:-3px; } }
  @media(max-width:760px) {
    .wrap { width:calc(100% - 40px); }
    .iv-hero { grid-template-columns:minmax(0,1fr); text-align:center; padding:65px 20px 85px;min-height:0; } .iv-hero h1 { font-size:clamp(44px,12vw,60px);letter-spacing:-3px; } .lede { font-size:16px; } .hero-art { width:350px;max-width:100%;height:auto;aspect-ratio:350/470; margin:45px auto 0; } .hero-poster { width:51.4%; } .hero-poster.front { left:8px;top:0; } .hero-poster.back { left:47.1%;top:8.5%; } .hero-orbit { width:94.3%;height:auto;aspect-ratio:1;left:2.8%;top:7.4%; } .hero-caption { bottom:0;right:15px; } .explore { left:20px;right:20px;text-align:left;font-size:11px;bottom:20px; }
    h2 { font-size:40px;letter-spacing:-1.8px; } .statement { padding-block:80px; } .statement>p:last-child { font-size:15px; } .feature { grid-template-columns:1fr;gap:30px;margin-bottom:70px; } .private .feature-copy { grid-row:1; } .feature-copy { padding-inline:10px; } .feature-copy>p:not(.eyebrow) { font-size:16px;max-width:100%; } .feature-art { height:550px; } .feature-art :global(picture) { width:225px; } .entrances { padding-top:10px;padding-bottom:70px; } .section-heading>p:last-child { font-size:15px; } .entrance-grid { grid-template-columns:1fr;margin-top:35px; } .entrance { height:660px; } .entrance-copy { padding:32px 28px 0; } h3 { font-size:25px; } .entrance :global(picture) { width:210px; } .gallery-section { padding-block:65px; } .gallery-heading { align-items:center; } .gallery-heading h2 { font-size:30px;letter-spacing:-1px; } .gallery-controls { gap:6px; } .gallery-controls button { width:35px;height:35px; } .gallery-heading p:last-child { font-size:13px; } .gallery-track { padding:30px 20px 20px;gap:24px; } .gallery-track figure { width:76vw;max-width:310px; } .ipad-section { padding-top:70px; } .ipad-art { padding:18px;border-radius:18px; } .gallery-device { height:510px;padding:25px; } .gallery-device :global(picture) { width:210px;max-width:100%; } .download { padding-block:70px; } .download>p:not(.wordmark) { font-size:14px;padding-inline:15px; }
  }
  @media(prefers-reduced-motion:reduce) { .invsi :global(.pp-store) { transition:none; } }
</style>
