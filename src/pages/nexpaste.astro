---
import BaseLayout from "../layouts/BaseLayout.astro";
import MainFooter from "../components/MainFooter.astro";
import MainNav from "../components/MainNav.astro";
---

<BaseLayout
  title="NexPaste - Mac 与 iPhone 上的剪贴板管家"
  description="NexPaste 是为 Mac 打造的原生剪贴板管理器，现已推出 iPhone 和 iPad 版。支持文本、图片、文件历史，快速搜索、迷你面板、标签与收藏，默认本地保存，Pro 可通过 iCloud 在设备间同步。"
  canonical="https://maxc.cc/nexpaste/"
  ogImage="https://maxc.cc/images/nexpaste-icon.png"
  includeHomeStyles={true}
  includeHomeScript={true}
>
  <MainNav showSectionLinks={false} />

  <div class="nexpaste-landing-page">
      <main id="top">
        <header class="hero">
          <div class="hero-content">
            <img class="app-icon" src="/images/nexpaste-icon.png" alt="NexPaste 应用图标">
            <h1 class="reveal" data-i18n="np_landing_hero_title">复制过的，瞬间回来。</h1>
            <p class="hero-copy reveal" data-i18n="np_landing_hero_copy">为 macOS 打造的原生剪贴板管家。轻轻一搜，马上可用。</p>
            <div class="cta-row reveal">
              <a class="primary-link" href="https://apps.apple.com/app/id6761368515" data-i18n="np_landing_app_store">App Store</a>
            </div>

            <figure class="store-hero reveal">
              <img src="/images/nexpaste/mac-overview.png" width="2880" height="1800" alt="NexPaste Mac 商店图：剪贴板历史与分类面板" fetchpriority="high" decoding="async">
            </figure>
          </div>
        </header>

        <section id="workflow">
          <div class="section-inner">
            <p class="section-kicker reveal" data-i18n="np_landing_workflow_kicker">毫秒级呼出</p>
            <h2 class="section-title reveal" data-i18n="np_landing_workflow_title">需要时出现。用完就退场。</h2>
            <p class="section-lead reveal" data-i18n="np_landing_workflow_lead">快捷键呼出，左右滑动浏览，回车使用。</p>

            <div class="feature-band split reveal">
              <div class="split-text">
                <h3 data-i18n="np_landing_keyboard_title">键盘优先。</h3>
                <p data-i18n="np_landing_keyboard_desc">搜索、筛选、选择，都在同一个轻量面板里完成。</p>
              </div>
              <div class="command-visual" aria-label="快捷键视觉">
                <div class="key-stack">
                  <div class="key">⇧</div>
                  <div class="key">⌘</div>
                  <div class="key key-space">Space</div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="features">
          <div class="section-inner">
            <p class="section-kicker reveal" data-i18n="np_landing_features_kicker">更聪明的历史</p>
            <h2 class="section-title reveal" data-i18n="np_landing_features_title">把剪贴板变成可复用的内容库。</h2>
            <div class="tile-grid">
              <article class="tile reveal">
                <h3 data-i18n="np_landing_auto_title">自动分类。</h3>
                <p data-i18n="np_landing_auto_desc">文本、图片、文件和链接，清晰呈现。</p>
                <div class="tile-visual">
                  <div class="tag-cloud">
                    <span class="tag" data-i18n="np_landing_chip_text">文本</span>
                    <span class="tag" data-i18n="np_landing_chip_images">图片</span>
                    <span class="tag" data-i18n="np_landing_chip_files">文件</span>
                    <span class="tag" data-i18n="np_landing_chip_links">链接</span>
                    <span class="tag" data-i18n="np_landing_tag_favorite">收藏</span>
                  </div>
                </div>
              </article>
              <article class="tile reveal">
                <h3 data-i18n="np_landing_pinned_title">常用常驻。</h3>
                <p data-i18n="np_landing_pinned_desc">账号、模板、命令和素材，用标签收好。</p>
                <div class="tile-visual">
                  <div class="tag-cloud">
                    <span class="tag" data-i18n="np_landing_tag_account">账号</span>
                    <span class="tag" data-i18n="np_landing_tag_company">公司</span>
                    <span class="tag" data-i18n="np_landing_tag_common_plain">常用</span>
                    <span class="tag" data-i18n="np_landing_tag_code_plain">代码</span>
                    <span class="tag" data-i18n="np_landing_tag_client">客户</span>
                  </div>
                </div>
              </article>
              <article class="tile reveal">
                <h3 data-i18n="np_landing_mini_title">迷你面板。</h3>
                <p data-i18n="np_landing_mini_desc">更轻、更近，适合高频操作。</p>
                <div class="tile-visual">
                  <div class="sync-orbit">
                    <div class="sync-center">⌘</div>
                  </div>
                </div>
              </article>
            </div>
          </div>
        </section>

        <section id="privacy">
          <div class="section-inner">
            <p class="section-kicker reveal" data-i18n="np_landing_privacy_kicker">隐私优先</p>
            <h2 class="section-title reveal" data-i18n="np_landing_privacy_title">你的历史，留在你的 Mac。</h2>
            <p class="section-lead reveal" data-i18n="np_landing_privacy_lead">本地保存。可暂停记录，也可过滤指定应用。</p>

            <div class="feature-band split reveal">
              <div class="command-visual">
                <div class="privacy-vault" aria-hidden="true">
                  <div class="privacy-dots"><span></span><span></span><span></span></div>
                  <div class="privacy-shield"></div>
                  <div class="privacy-lines">
                    <span class="privacy-line"></span>
                    <span class="privacy-line"></span>
                  </div>
                </div>
              </div>
              <div class="split-text">
                <h3 data-i18n="np_landing_privacy_card_title">记录什么，由你决定。</h3>
                <p data-i18n="np_landing_privacy_card_desc">敏感 App 可过滤。历史也能随时清空。</p>
              </div>
            </div>
          </div>
        </section>

        <section id="iphone">
          <div class="section-inner">
            <p class="section-kicker reveal" data-i18n="np_landing_mobile_kicker">现在也在 iPhone 上</p>
            <h2 class="section-title reveal" data-i18n="np_landing_mobile_title">在 Mac 上复制的，iPhone 上也找得到。</h2>
            <p class="section-lead reveal" data-i18n="np_landing_mobile_lead">iPhone 和 iPad 版用卡片展示历史，支持搜索和收藏。</p>

            <div class="feature-band split reveal">
              <div class="split-text">
                <h3 data-i18n="np_landing_mobile_card_title">一键存下剪贴板。</h3>
                <p data-i18n="np_landing_mobile_card_desc">轻点底部的粘贴按钮，就能保存剪贴板里的文字、链接和图片；桌面小组件也能快速保存。长按卡片即可复制、收藏或删除。</p>
              </div>
              <div class="store-phone">
                <img src="/images/nexpaste/iphone-history.jpeg" width="1206" height="2622" alt="NexPaste iPhone 商店图：保存复制历史，需要时轻松找到" loading="lazy" decoding="async">
              </div>
            </div>
          </div>
        </section>

        <section class="store-gallery" aria-label="NexPaste 收藏与多设备同步">
          <div class="section-inner store-gallery-grid">
            <figure>
              <img src="/images/nexpaste/iphone-favorites.jpeg" width="1206" height="2622" alt="NexPaste 中文商店图：收藏常用地址、电话、句子和链接" loading="lazy" decoding="async">
            </figure>
            <figure>
              <img src="/images/nexpaste/icloud-devices.jpeg" width="1206" height="2622" alt="NexPaste 中文商店图：通过 iCloud 在 Mac、iPhone 和 iPad 间同步" loading="lazy" decoding="async">
            </figure>
          </div>
        </section>

        <section class="pro" aria-label="高级能力">
          <div class="section-inner">
            <p class="section-kicker reveal" data-i18n="np_landing_pro_kicker">为长期使用打磨</p>
            <h2 class="section-title reveal" data-i18n="np_landing_pro_title">轻巧。原生。足够强大。</h2>
            <p class="section-lead reveal" data-i18n="np_landing_pro_lead">SwiftUI、系统材质、快捷键和同步能力，一应俱全。</p>
            <div class="pro-card">
              <div class="pro-item reveal">
                <strong data-i18n="np_landing_sync_title">iCloud 同步</strong>
                <span data-i18n="np_landing_sync_desc">文本、图片、文件，按需同步。</span>
              </div>
              <div class="pro-item reveal">
                <strong data-i18n="np_landing_settings_title">精细设置</strong>
                <span data-i18n="np_landing_settings_desc">面板、语言、快捷键，都能调整。</span>
              </div>
              <div class="pro-item reveal">
                <strong data-i18n="np_landing_native_title">原生体验</strong>
                <span data-i18n="np_landing_native_desc">系统材质、状态栏菜单和标准 macOS 交互。</span>
              </div>
              <div class="pro-item reveal">
                <strong data-i18n="np_landing_perf_title">高性能预览</strong>
                <span data-i18n="np_landing_perf_desc">快速响应，后台轻量。</span>
              </div>
            </div>
          </div>
        </section>

        <section id="download" class="final">
          <div class="section-inner reveal">
            <img class="app-icon" src="/images/nexpaste-icon.png" alt="NexPaste 应用图标">
            <h2 data-i18n="np_landing_final_title">NexPaste<br>让复制粘贴重新变快。</h2>
            <p data-i18n="np_landing_final_desc">简洁、私密、随叫随到。</p>
            <div class="cta-row">
              <a class="primary-link" href="https://apps.apple.com/app/id6761368515" data-i18n="np_landing_go_app_store">前往 App Store</a>
              <a class="secondary-link" href="#top" data-i18n="np_landing_back_top">回到顶部</a>
            </div>
          </div>
        </section>
      </main>
  </div>

  <MainFooter />

  <style>
    .store-hero { margin: 52px auto 0; max-width: 1120px; }
    .store-hero img { width: 100%; height: auto; border-radius: 22px; box-shadow: 0 24px 70px #142c4926; }
    .store-phone { width: min(100%, 360px); margin: 0 auto; }
    .store-phone img { width: 100%; height: auto; border-radius: 24px; }
    .store-gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; max-width: 900px; }
    .store-gallery figure { margin: 0; }
    .store-gallery img { width: 100%; height: auto; border-radius: 24px; }
    @media (max-width: 600px) {
      .store-hero { margin-top: 32px; }
      .store-hero img { border-radius: 12px; }
      .store-gallery-grid { grid-template-columns: 1fr; max-width: 420px; gap: 24px; }
    }

    .nexpaste-landing-page {
          color-scheme: light;
          --bg: #f5f5f7;
          --surface: rgba(255, 255, 255, 0.78);
          --surface-strong: rgba(255, 255, 255, 0.92);
          --ink: #1d1d1f;
          --muted: #6e6e73;
          --hairline: rgba(0, 0, 0, 0.08);
          --blue: #0071e3;
          --cyan: #00a5d8;
          --green: #2fd068;
          --orange: #ff9f0a;
          --pink: #ff375f;
          --shadow: 0 28px 80px rgba(0, 0, 0, 0.16);
          --soft-shadow: 0 18px 60px rgba(0, 0, 0, 0.11);
          --radius: 28px;
        }

        * {
          box-sizing: border-box;
        }

    :global(html) {
      scroll-behavior: smooth;
      background: #f5f5f7;
    }

    :global(body) {
      margin: 0;
    }

        .nexpaste-landing-page {
          margin: 0;
          font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
          color: var(--ink);
          background:
            radial-gradient(circle at 50% -4%, rgba(0, 113, 227, 0.10), transparent 30rem),
            linear-gradient(180deg, #fff 0%, var(--bg) 24rem);
          letter-spacing: 0;
          overflow-x: hidden;
        }

        a {
          color: inherit;
          text-decoration: none;
        }

        img {
          display: block;
          max-width: 100%;
        }

        .hero {
          position: relative;
          display: grid;
          align-items: end;
          min-height: 94vh;
          padding: 116px 22px 34px;
          isolation: isolate;
        }

        .hero-content {
          width: min(1280px, 100%);
          margin: 0 auto;
          text-align: center;
        }

        .app-icon {
          width: 88px;
          height: 88px;
          margin: 0 auto 22px;
          border-radius: 22px;
          box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22);
          animation: floatIcon 5s ease-in-out infinite;
        }

        .eyebrow {
          margin: 0 0 12px;
          color: var(--blue);
          font-size: 18px;
          font-weight: 700;
          line-height: 1.2;
        }

        h1 {
          max-width: 860px;
          margin: 0 auto;
          font-size: clamp(40px, 6vw, 76px);
          font-weight: 700;
          line-height: 1.02;
          letter-spacing: 0;
        }

        .hero-copy {
          max-width: 640px;
          margin: 18px auto 0;
          color: var(--muted);
          font-size: clamp(17px, 1.8vw, 22px);
          font-weight: 500;
          line-height: 1.28;
        }

        .cta-row {
          display: flex;
          justify-content: center;
          gap: 18px;
          margin: 26px 0 36px;
          font-size: 17px;
          font-weight: 500;
        }

        .primary-link,
        .secondary-link {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          min-height: 44px;
          padding: 0 24px;
          border-radius: 999px;
          transition: transform 180ms ease, background 180ms ease;
        }

        .primary-link {
          color: #fff;
          background: var(--blue);
        }

        .secondary-link {
          color: var(--blue);
          background: rgba(0, 113, 227, 0.10);
        }

        .primary-link:hover,
        .secondary-link:hover {
          transform: translateY(-1px);
        }

        .hero-stage {
          position: relative;
          width: min(1240px, 100%);
          margin: 0 auto;
          min-height: 360px;
          perspective: 1600px;
        }

        section {
          padding: 88px 22px;
        }

        .section-inner {
          max-width: 1120px;
          margin: 0 auto;
        }

        .section-kicker {
          margin: 0 0 10px;
          color: var(--blue);
          font-size: 18px;
          font-weight: 700;
          line-height: 1.2;
        }

        .section-title {
          max-width: 900px;
          margin: 0;
          font-size: clamp(30px, 4.5vw, 52px);
          font-weight: 700;
          line-height: 1.04;
        }

        .section-lead {
          max-width: 760px;
          margin: 22px 0 0;
          color: var(--muted);
          font-size: clamp(17px, 2vw, 22px);
          font-weight: 500;
          line-height: 1.3;
        }

        .feature-band {
          margin-top: 52px;
          border-radius: var(--radius);
          background: #fff;
          overflow: hidden;
          box-shadow: 0 1px 0 var(--hairline);
        }

        .split {
          display: grid;
          grid-template-columns: 0.95fr 1.05fr;
          min-height: 560px;
        }

        .split-text {
          display: grid;
          align-content: center;
          padding: clamp(32px, 5vw, 64px);
        }

        .split-text h3,
        .tile h3 {
          margin: 0;
          font-size: clamp(26px, 3vw, 38px);
          font-weight: 700;
          line-height: 1.06;
        }

        .split-text p,
        .tile p {
          margin: 18px 0 0;
          color: var(--muted);
          font-size: 18px;
          font-weight: 500;
          line-height: 1.38;
        }

        .command-visual {
          position: relative;
          display: grid;
          place-items: center;
          min-height: 560px;
          background:
            linear-gradient(135deg, rgba(0, 113, 227, 0.13), rgba(47, 208, 104, 0.10)),
            var(--bg);
        }

        .key-stack {
          display: flex;
          gap: 14px;
          transform: rotate(-8deg);
        }

        .key {
          display: grid;
          place-items: center;
          width: clamp(74px, 10vw, 118px);
          height: clamp(74px, 10vw, 118px);
          border: 1px solid var(--hairline);
          border-radius: 24px;
          background: rgba(255, 255, 255, 0.78);
          box-shadow: 0 18px 48px rgba(0, 0, 0, 0.12);
          font-size: clamp(24px, 4vw, 42px);
          font-weight: 700;
          animation: keyPress 4.8s ease-in-out infinite;
        }

        .key:nth-child(2) { animation-delay: 0.16s; }
        .key:nth-child(3) { animation-delay: 0.32s; }

        .key-space {
          padding-inline: 8px;
          font-size: clamp(15px, 2.2vw, 24px);
          line-height: 1;
          overflow: hidden;
        }

        .tile-grid {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 18px;
          margin-top: 52px;
        }

        .tile {
          min-height: 430px;
          overflow: hidden;
          border-radius: var(--radius);
          background: #fff;
          padding: 34px;
          box-shadow: 0 1px 0 var(--hairline);
        }

        .tile h3 {
          font-size: clamp(23px, 2.4vw, 30px);
        }

        .tile p {
          font-size: 16px;
        }

        .tile-visual {
          position: relative;
          height: 190px;
          margin: 30px -12px -8px;
        }

        .privacy-vault {
          position: relative;
          width: min(420px, calc(100% - 48px));
          min-height: 300px;
          border: 1px solid rgba(0, 0, 0, 0.08);
          border-radius: 30px;
          background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.62)),
            radial-gradient(circle at 50% 0%, rgba(0, 113, 227, 0.14), transparent 62%);
          box-shadow: 0 24px 70px rgba(0, 0, 0, 0.12);
          overflow: hidden;
        }

        .privacy-vault::before {
          content: "";
          position: absolute;
          inset: 0 0 auto;
          height: 48px;
          border-bottom: 1px solid rgba(0, 0, 0, 0.06);
          background: rgba(255, 255, 255, 0.56);
        }

        .privacy-dots {
          position: absolute;
          top: 20px;
          left: 22px;
          display: flex;
          gap: 7px;
        }

        .privacy-dots span {
          width: 9px;
          height: 9px;
          border-radius: 50%;
          background: rgba(60, 60, 67, 0.22);
        }

        .privacy-shield {
          position: absolute;
          top: 78px;
          left: 50%;
          width: 112px;
          height: 128px;
          transform: translateX(-50%);
          border-radius: 34px 34px 42px 42px;
          background: linear-gradient(180deg, #34c759, #0a84ff);
          box-shadow: 0 18px 42px rgba(0, 113, 227, 0.26);
          clip-path: polygon(50% 0, 92% 16%, 86% 76%, 50% 100%, 14% 76%, 8% 16%);
        }

        .privacy-shield::before {
          content: "";
          position: absolute;
          inset: 12px;
          background: rgba(255, 255, 255, 0.20);
          clip-path: inherit;
        }

        .privacy-shield::after {
          content: "";
          position: absolute;
          left: 37px;
          top: 46px;
          width: 38px;
          height: 22px;
          border-left: 8px solid rgba(255, 255, 255, 0.94);
          border-bottom: 8px solid rgba(255, 255, 255, 0.94);
          border-radius: 0 0 0 6px;
          transform: rotate(-45deg);
        }

        .privacy-lines {
          position: absolute;
          left: 32px;
          right: 32px;
          bottom: 28px;
          display: grid;
          gap: 10px;
        }

        .privacy-line {
          height: 14px;
          border-radius: 999px;
          background: rgba(60, 60, 67, 0.10);
        }

        .privacy-line:nth-child(1) { width: 76%; }
        .privacy-line:nth-child(2) { width: 58%; }

        .tag-cloud {
          display: flex;
          flex-wrap: wrap;
          align-content: center;
          justify-content: center;
          gap: 10px;
          height: 100%;
        }

        .tag {
          padding: 8px 13px;
          border-radius: 999px;
          background: rgba(0, 113, 227, 0.11);
          color: var(--blue);
          font-size: 12px;
          font-weight: 700;
        }

        .sync-orbit {
          position: absolute;
          inset: 8px 22px;
          display: grid;
          place-items: center;
        }

        .sync-orbit::before,
        .sync-orbit::after {
          content: "";
          position: absolute;
          border: 1px solid var(--hairline);
          border-radius: 50%;
        }

        .sync-orbit::before {
          width: 190px;
          height: 112px;
          transform: rotate(18deg);
        }

        .sync-orbit::after {
          width: 190px;
          height: 112px;
          transform: rotate(-18deg);
        }

        .sync-center {
          display: grid;
          place-items: center;
          width: 84px;
          height: 84px;
          border-radius: 22px;
          background: var(--surface-strong);
          box-shadow: 0 12px 34px rgba(0, 0, 0, 0.12);
          font-size: 30px;
        }

        .pro {
          background:
            radial-gradient(circle at 50% 0%, rgba(255, 159, 10, 0.12), transparent 28rem),
            var(--bg);
          color: var(--ink);
        }

        .pro .section-kicker {
          color: var(--orange);
        }

        .pro .section-lead {
          color: var(--muted);
        }

        .pro-card {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 18px;
          margin-top: 52px;
        }

        .pro-item {
          min-height: 220px;
          border: 1px solid rgba(0, 0, 0, 0.08);
          border-radius: var(--radius);
          background: rgba(255, 255, 255, 0.82);
          padding: 34px;
          backdrop-filter: blur(18px);
          -webkit-backdrop-filter: blur(18px);
        }

        .pro-item strong {
          display: block;
          font-size: 22px;
          line-height: 1.16;
        }

        .pro-item span {
          display: block;
