---
import BaseLayout from '../layouts/BaseLayout.astro';
import MainNav from '../components/MainNav.astro';
import MainFooter from '../components/MainFooter.astro';
import StoreButton from '../components/mock/StoreButton.astro';
import { nexpasteRedesign } from '../i18n/nexpaste-redesign';
const t = (key: string) => nexpasteRedesign['zh-CN'][`npr_${key}` as keyof typeof nexpasteRedesign['zh-CN']];
const asset = (name: string) => `/images/nexpaste/redesign/${name}.webp`;
const store = 'https://apps.apple.com/app/id6761368515';
---
<BaseLayout title="NexPaste — 复制过的，随时找回" description="保存文字、链接、图片和文件，在 Mac、iPhone 和 iPad 间通过 iCloud 接续。" canonical="https://maxc.cc/nexpaste/" ogImage="https://maxc.cc/images/nexpaste/redesign/hero-mac.png" includeHomeStyles includeHomeScript>
  <script slot="head" is:inline define:vars={{ nexpasteRedesign }}>
    for (const [lang, copy] of Object.entries(nexpasteRedesign)) Object.assign(window.DoCoolI18n.shared[lang], copy);
  </script>
  <MainNav showSectionLinks={false} />
  <main class="np-page" id="top">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><img src="/images/nexpaste-icon.png" width="28" height="28" alt="" /><span data-i18n="npr_eyebrow">{t('eyebrow')}</span></p>
        <h1><span data-i18n="npr_title1">{t('title1')}</span><span class="gradient" data-i18n="npr_title2">{t('title2')}</span></h1>
        <p class="lede" data-i18n="npr_lead">{t('lead')}</p>
        <div class="actions"><StoreButton href={store} /></div>
        <p class="platforms" data-i18n="npr_platforms">{t('platforms')}</p>
      </div>
      <figure class="hero-stage"><div class="window-bar" aria-hidden="true"><span class="traffic"><i></i><i></i><i></i></span><span>NexPaste / macOS</span><span>⌘ ⇧ V</span></div><img src="/images/nexpaste/redesign/hero-mac.png" width="3024" height="1964" alt="NexPaste Mac 真实界面：剪贴板历史、内容分类与搜索" fetchpriority="high" /></figure>
    </section>
    <div class="promise shell">{['strip1','strip2','strip3'].map((key,i)=><div><span aria-hidden="true">{['▦','☁','◎'][i]}</span><p data-i18n={`npr_${key}`}>{t(key)}</p></div>)}</div>
    <section class="library shell" id="features">
      <div class="heading"><p class="eyebrow" data-i18n="npr_library_k">{t('library_k')}</p><h2 data-i18n="npr_library_title">{t('library_title')}</h2><p data-i18n="npr_library_desc">{t('library_desc')}</p></div>
      <div class="content-cards" aria-label="支持的剪贴板内容类型">
        <article class="clip text-clip"><div class="clip-label"><span>Aa</span><span data-i18n="npr_text">{t('text')}</span></div><p data-i18n="npr_sample1">{t('sample1')}</p><span class="clip-footer">NexPaste · TEXT</span></article>
        <article class="clip link-clip"><div class="clip-label"><span>↗</span><span data-i18n="npr_links">{t('links')}</span></div><div class="link-mark" aria-hidden="true">↗</div><p data-i18n="npr_sample2">{t('sample2')}</p><span class="clip-footer">apple.com</span></article>
        <article class="clip image-clip"><div class="clip-label"><span>▧</span><span data-i18n="npr_images">{t('images')}</span></div><div class="color-study" aria-hidden="true"></div><p data-i18n="npr_sample3">{t('sample3')}</p></article>
        <article class="clip file-clip"><div class="clip-label"><span>▤</span><span data-i18n="npr_files">{t('files')}</span></div><div class="file-icon" aria-hidden="true">PDF</div><p data-i18n="npr_sample4">{t('sample4')}</p><span class="clip-footer">DOCUMENT</span></article>
      </div>
      <div class="library-notes">{['retain','find'].map((key,i)=><article><span class="number">0{i+1}</span><div><h3 data-i18n={`npr_${key}`}>{t(key)}</h3><p data-i18n={`npr_${key}_desc`}>{t(`${key}_desc`)}</p></div></article>)}</div>
    </section>
    <section class="workflow shell">
      <div class="workflow-copy"><p class="eyebrow" data-i18n="npr_mac_k">{t('mac_k')}</p><h2 data-i18n="npr_mac_title">{t('mac_title')}</h2><p class="body-copy" data-i18n="npr_mac_desc">{t('mac_desc')}</p><p class="fine" data-i18n="npr_mac_note">{t('mac_note')}</p></div>
      <div class="keyboard-stage"><span class="stage-caption">A SHORTCUT TO EVERYTHING.</span><div class="keys" aria-label="Command Shift V"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>V</kbd></div><ol>{['step1','step2','step3'].map((key,i)=><li><span>0{i+1}</span><strong data-i18n={`npr_${key}`}>{t(key)}</strong><span aria-hidden="true">{['⌘ ⇧ V','Aa','↵'][i]}</span></li>)}</ol></div>
    </section>
    <section class="mobile-section" id="iphone">
      <div class="shell"><div class="heading"><p class="eyebrow" data-i18n="npr_mobile_k">{t('mobile_k')}</p><h2 data-i18n="npr_mobile_title">{t('mobile_title')}</h2><p data-i18n="npr_mobile_desc">{t('mobile_desc')}</p></div>
        <div class="phone-grid">{['history','widget','favorite'].map((key,i)=><article class:list={['phone-card',`phone-card-${i}`]}><div class="phone-copy"><span class="mini-label">0{i+1} / {['CAPTURE','QUICK SAVE','FAVORITES'][i]}</span><h3 data-i18n={`npr_${key}_title`}>{t(`${key}_title`)}</h3><p data-i18n={`npr_${key}_desc`}>{t(`${key}_desc`)}</p></div><img src={asset(['phone-history','phone-widget','phone-favorites'][i])} width="860" height="1800" loading="lazy" alt={['NexPaste iPhone 剪贴板历史','NexPaste 桌面小组件','NexPaste iPhone 收藏夹'][i]} /></article>)}</div>
      </div>
    </section>
    <section class="sync shell" id="sync"><div class="sync-copy"><p class="eyebrow" data-i18n="npr_sync_k">{t('sync_k')}</p><h2 data-i18n="npr_sync_title">{t('sync_title')}</h2><p class="body-copy" data-i18n="npr_sync_desc">{t('sync_desc')}</p><div class="device-labels"><span>Mac</span><i>↔</i><span>iPhone</span><i>↔</i><span>iPad</span></div><p class="fine" data-i18n="npr_sync_note">{t('sync_note')}</p></div><div class="sync-art"><img src={asset('icloud-devices')} width="2000" height="1407" loading="lazy" alt="NexPaste 在 Mac、iPhone 和 iPad 间通过 iCloud 同步" /></div></section>
    <section class="devices shell" id="devices"><div class="heading"><p class="eyebrow" data-i18n="npr_devices_k">{t('devices_k')}</p><h2 data-i18n="npr_devices_title">{t('devices_title')}</h2></div><div class="device-grid">{['ipad','duo'].map(key=><article class:list={['device-card',key]}><div><span class="mini-label">{key==='ipad'?'iPadOS':'iPhone Duo'}</span><h3 data-i18n={`npr_${key}_title`}>{t(`${key}_title`)}</h3><p data-i18n={`npr_${key}_desc`}>{t(`${key}_desc`)}</p></div><img src={asset(key==='ipad'?'ipad':'iphone-duo')} width={key==='ipad'?1350:2000} height={key==='ipad'?1800:1407} loading="lazy" alt={key==='ipad'?'NexPaste iPad 卡片布局':'NexPaste iPhone Duo 列表与内容预览布局'} /></article>)}</div></section>
    <section class="privacy shell"><div class="privacy-mark" aria-hidden="true">◎</div><p class="eyebrow" data-i18n="npr_privacy_k">{t('privacy_k')}</p><h2 data-i18n="npr_privacy_title">{t('privacy_title')}</h2><p data-i18n="npr_privacy_desc">{t('privacy_desc')}</p></section>
    <section class="faq shell"><h2 data-i18n="npr_faq">{t('faq')}</h2><div>{[1,2,3,4].map(i=><details><summary><span data-i18n={`npr_q${i}`}>{t(`q${i}`)}</span><span class="plus" aria-hidden="true">＋</span></summary><p data-i18n={`npr_a${i}`}>{t(`a${i}`)}</p></details>)}</div></section>
    <section class="final" id="download"><img src="/images/nexpaste-icon.png" width="76" height="76" alt="NexPaste" /><h2 data-i18n="npr_final_title">{t('final_title')}</h2><p data-i18n="npr_final_desc">{t('final_desc')}</p><StoreButton href={store} /><span class="platforms">Mac · iPhone · iPad</span></section>
  </main>
  <MainFooter />
</BaseLayout>
<style>
  :global(html){scroll-behavior:smooth;scroll-padding-top:90px;background:#fafbff}
  :global(body){margin:0;background:#fafbff!important;color:#202335!important;--text-primary:#202335;--text-secondary:#72788b;--bg-color:#fafbff;--border-color:#e5e7ef}
  :global(.theme-toggle){display:none!important}
  :global(body>nav){background:#fafbfff0!important;border-color:#e5e7ef!important;color:#202335!important}
  :global(body>footer){background:#f1f3f9!important;color:#72788b!important}
  .np-page{--ink:#202335;--muted:#73798c;--accent:#5963d8;color:var(--ink);background:#fafbff;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','PingFang SC',sans-serif;overflow:clip;padding-top:48px}
  .np-page *{box-sizing:border-box}.np-page :is(h1,h2,h3,p,figure){margin:0}.np-page a{text-decoration:none;color:inherit}.np-page img{display:block;max-width:100%;height:auto}.np-page a:focus-visible,.np-page summary:focus-visible{outline:3px solid #5963d8;outline-offset:7px}
  .shell{width:min(1180px,100% - 64px);margin-inline:auto}.eyebrow{font-size:12px;font-weight:600;letter-spacing:.09em;color:var(--accent);line-height:1.6}.hero{padding:64px 32px 0;background:radial-gradient(ellipse 55% 40% at 50% 35%,#e7eaff99,transparent)}
  .hero-copy{width:100%;display:flex;flex-direction:column;align-items:center;text-align:center}.hero-copy > :is(h1,p,.actions){margin-inline:auto}.hero-copy .lede{max-width:760px;text-align:center}.hero-copy .platforms{text-align:center}.hero .eyebrow{display:flex;align-items:center;justify-content:center;gap:10px}.hero .eyebrow img{border-radius:7px}h1{font-size:clamp(46px,6.2vw,84px);font-weight:650;letter-spacing:-.065em;line-height:1.2;margin-top:24px!important}h1 span{display:inline-block}.gradient{background:linear-gradient(105deg,#4881db,#7370d6 65%,#9b7aca);background-clip:text;-webkit-text-fill-color:transparent}
  .lede{white-space:pre-line;color:#6d7488;font-size:17px;line-height:1.9;margin-top:24px!important}.actions{display:flex;justify-content:center;align-items:center;gap:28px;margin-top:28px}.np-page :global(.pp-store){display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:100px;background:#22283c;color:#fff;padding:14px 23px;font-size:13px;font-weight:550;box-shadow:0 8px 18px #20233513;transition:transform .2s,background .2s}.np-page :global(.pp-store:hover){transform:translateY(-2px);background:#4953b7}.np-page :global(.pp-store svg){width:22px;height:22px;fill:currentColor}.text-link{font-size:13px;color:#5f677c!important;display:flex;gap:15px}.platforms{display:block;color:#969bad;font-size:11px;letter-spacing:.04em;margin-top:18px!important}
  .hero-stage{max-width:1050px;margin:44px auto 0!important;border:1px solid #fff;border-radius:16px;box-shadow:0 28px 75px #353b7025;overflow:hidden;background:#fff}.window-bar{height:34px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;color:#9297a5;background:#f4f5f9;font-size:9px;letter-spacing:.04em}.traffic{display:flex;gap:5px}.traffic i{width:7px;height:7px;border-radius:50%;background:#ffb5ae}.traffic i:nth-child(2){background:#f5d58a}.traffic i:nth-child(3){background:#aad7b8}.hero-stage img{width:100%}
  .promise{display:grid;grid-template-columns:repeat(3,1fr);padding:35px 0;margin-top:40px;border-bottom:1px solid #e6e8f0}.promise>div{display:flex;align-items:center;justify-content:center;gap:12px;font-size:12px;color:#6f7588}.promise>div>span{color:#7f88be;font-size:22px}.promise>div+div{border-left:1px solid #e6e8f0}
  .library{padding-block:110px 85px}.heading{max-width:690px;margin:auto;text-align:center}h2{font-size:clamp(32px,3.8vw,50px);font-weight:620;line-height:1.3;letter-spacing:-.045em;white-space:pre-line}.heading h2{margin-top:17px}.heading>p:last-child:not(.eyebrow){font-size:15px;line-height:1.9;color:var(--muted);margin-top:20px}.content-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:48px}.clip{min-height:250px;background:#fff;border:1px solid #e6e9f2;border-radius:18px;padding:22px;position:relative;box-shadow:0 8px 25px #393f6b05;transition:transform .25s}.clip:hover{transform:translateY(-6px)}.clip:nth-child(even){transform:translateY(14px)}.clip:nth-child(even):hover{transform:translateY(8px)}.clip-label{display:flex;justify-content:space-between;align-items:center;color:#8a90a5;font-size:11px}.clip-label>span:first-child{font-size:18px;color:#7581b5}.clip p{font-size:19px;line-height:1.6;font-weight:550;margin-top:28px!important}.clip-footer{font-size:9px;letter-spacing:.07em;color:#a3a8b7;display:block;margin-top:30px}.text-clip{background:#f0f1fc}.text-clip p{font-size:25px;max-width:170px}.link-mark{font-size:35px;color:#83a1bc;margin-top:16px}.link-clip p{font-size:15px;margin-top:10px!important}.image-clip p,.file-clip p{font-size:13px;margin-top:13px!important}.color-study{height:112px;border-radius:9px;margin-top:19px;background:radial-gradient(ellipse at 20% 120%,#eabeb2 0,transparent 60%),radial-gradient(ellipse at 80% 20%,#b4b4e7 0,transparent 65%),#dbe4e7}.file-icon{width:60px;height:76px;background:#eef1fa;color:#8d97bc;border:1px solid #dbe0f2;border-radius:7px;display:grid;place-items:center;font-size:12px;letter-spacing:.08em;margin:20px auto 0}.file-clip{text-align:center}.file-clip .clip-label{text-align:left}.file-clip .clip-footer{margin-top:10px}
  .library-notes{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:62px}.library-notes article{display:flex;gap:20px}.number{font-size:12px;color:#a0a7c4;padding-top:5px;font-family:monospace}h3{font-size:22px;font-weight:600;letter-spacing:-.025em;line-height:1.5}.library-notes p,.body-copy{font-size:15px;line-height:1.95;color:var(--muted);margin-top:12px!important}
  .workflow{display:grid;grid-template-columns:.85fr 1.15fr;gap:90px;align-items:center;padding-block:65px 120px}.workflow h2,.sync h2{margin-top:18px}.workflow .body-copy{margin-top:24px!important}.fine{font-size:11px;line-height:1.9;color:#959bad;margin-top:22px!important}.keyboard-stage{background:linear-gradient(135deg,#eceefa,#f4f5fb);border:1px solid #e5e8f3;border-radius:26px;padding:34px 40px}.stage-caption{font:9px monospace;letter-spacing:.14em;color:#8e96b4}.keys{display:flex;justify-content:center;gap:12px;padding:48px 0 55px;perspective:500px}.keys kbd{width:90px;height:90px;display:grid;place-items:center;background:linear-gradient(#fff,#f6f6fc);border-radius:16px;font-size:36px;color:#59617f;border:1px solid #fff;box-shadow:0 6px 0 #d6daeb,0 15px 25px #6b76a42c;transform:rotateX(12deg) rotateZ(-7deg);font-family:inherit}.keyboard-stage ol{list-style:none;padding:0;margin:0}.keyboard-stage li{display:flex;align-items:center;gap:20px;border-top:1px solid #dce1ef;padding:17px 0;font-size:12px;color:#8c94ad}.keyboard-stage strong{font-weight:500;color:#5f6884;flex:1}.keyboard-stage li>span:last-child{font-family:monospace}
  .mobile-section{background:#f0f2f9;padding:90px 0}.phone-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:50px}.phone-card{background:#e6ebf5;border-radius:24px;overflow:hidden;padding:30px 28px 0}.phone-card-1{background:#e7e7f4}.phone-card-2{background:#f0e9e7}.mini-label{font-size:9px;letter-spacing:.12em;color:#9399af;font-weight:600}.phone-copy h3{font-size:20px;margin-top:16px}.phone-copy p,.device-card p{font-size:13px;line-height:1.9;color:var(--muted);margin-top:10px}.phone-card img{border-radius:16% / 8%;width:235px;margin:28px auto -42px;filter:drop-shadow(0 15px 18px #252c5025)}
  .sync{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;align-items:center;padding-block:125px 90px}.sync-art{background:white;border-radius:24px;overflow:hidden}.sync-art img{width:100%}.device-labels{display:flex;gap:12px;align-items:center;margin-top:24px;color:#5968a3;font-size:11px}.device-labels span{border:1px solid #e0e4f0;border-radius:30px;padding:7px 13px}.device-labels i{font-style:normal;color:#9ca6c1}.devices{padding-block:35px 100px}.device-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:26px;margin-top:45px}.device-card{border:1px solid #e7e9f2;border-radius:24px;background:white;overflow:hidden;padding:35px 35px 0;display:flex;flex-direction:column}.device-card h3{margin-top:12px}.device-card img{object-fit:contain;flex:1;min-height:0}.ipad img{width:310px;margin:14px auto -15px}.duo img{width:100%;margin:auto;max-height:440px}.duo{background:#fff}.device-card>div{position:relative;z-index:1}
  .privacy{padding:60px 32px 65px;text-align:center;background:#eef0f9;border-radius:26px}.privacy-mark{font-size:55px;line-height:1;color:#8b96c2;margin-bottom:20px}.privacy h2{font-size:clamp(28px,3.3vw,42px);margin-top:14px}.privacy>p:last-child{max-width:610px;margin:20px auto 0;font-size:14px;line-height:1.95;color:var(--muted)}.faq{display:grid;grid-template-columns:.8fr 1.2fr;gap:65px;padding-block:110px}.faq h2{font-size:30px}.faq details{border-bottom:1px solid #e1e5ef;padding:21px 0}.faq details:first-child{padding-top:0}.faq summary{cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:14px;font-weight:500;list-style:none}.faq summary::-webkit-details-marker{display:none}.plus{color:#9099b6;font-weight:300;transition:transform .2s}.faq details[open] .plus{transform:rotate(45deg)}.faq details p{color:var(--muted);font-size:13px;line-height:1.95;margin-top:16px}.final{padding:75px 24px 95px;text-align:center;background:radial-gradient(ellipse 50% 75% at 50% 80%,#e1e5fa,transparent)}.final>img{margin:auto;border-radius:18px;box-shadow:0 15px 35px #343e741c}.final h2{margin-top:28px}.final>p{color:var(--muted);font-size:15px;margin-top:19px}.final :global(.pp-store){margin-top:27px}
  @media(min-width:1500px){.hero-stage{max-width:1120px}}
  @media(max-width:900px){.workflow{gap:36px}.keyboard-stage{padding:28px}.keys kbd{width:68px;height:74px;font-size:29px}.phone-grid{gap:15px}.phone-card{padding:25px 18px 0}.phone-copy h3{font-size:18px}.sync{gap:30px}.content-cards{gap:12px}.clip{padding:18px}.faq{gap:30px}.hero{padding-top:45px}.device-card{padding:28px 24px 0}}
  @media(max-width:650px){.shell{width:calc(100% - 40px)}.np-page{padding-top:48px}.hero{padding:44px 20px 0}h1{font-size:46px;letter-spacing:-.055em}h1 span{display:block}.lede{font-size:14px;line-height:1.85;white-space:normal;max-width:360px;margin-inline:auto!important}.hero .eyebrow{font-size:10px}.hero-stage{margin-top:32px!important;border-radius:10px;width:100%}.window-bar{height:24px;font-size:7px;padding:0 9px}.traffic i{width:5px;height:5px}.promise{padding:23px 0;margin-top:22px;gap:8px}.promise>div{flex-direction:column;gap:5px;text-align:center;font-size:9px}.promise>div>span{font-size:20px}.library{padding-block:70px 45px}.heading>p:last-child:not(.eyebrow){font-size:14px}h2{font-size:33px}.content-cards{grid-template-columns:repeat(2,1fr);gap:13px;margin-top:32px}.clip{min-height:220px}.clip p{font-size:18px}.text-clip p{font-size:22px}.image-clip p,.file-clip p{font-size:12px}.link-clip p{font-size:14px}.library-notes{grid-template-columns:1fr;gap:27px;margin-top:45px}.library-notes p,.body-copy{font-size:14px}.workflow{grid-template-columns:1fr;gap:30px;padding-block:35px 65px}.workflow-copy{max-width:450px}.workflow h2{white-space:normal}.keyboard-stage{padding:26px}.keys{padding-block:36px 42px}.keys kbd{width:76px;height:76px}.mobile-section{padding:65px 0}.phone-grid{grid-template-columns:1fr;gap:20px;margin-top:32px}.phone-card{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:15px;padding:24px 18px 0;min-height:330px}.phone-card img{width:100%;margin:0 auto -32px}.phone-copy{padding-bottom:24px}.phone-copy h3{font-size:20px}.phone-copy p{font-size:12px}.mini-label{font-size:8px}.sync{grid-template-columns:1fr;padding-block:70px 45px;gap:26px}.sync h2{white-space:normal}.sync-art img{max-width:520px;margin:auto}.devices{padding-block:20px 65px}.device-grid{grid-template-columns:1fr;gap:20px;margin-top:30px}.device-card{padding:27px 27px 0}.ipad img{max-width:250px}.duo img{margin:24px auto;max-height:none}.privacy{padding:40px 22px}.privacy h2{font-size:29px}.faq{grid-template-columns:1fr;padding-block:65px;gap:30px}.faq h2{font-size:27px}.final{padding-block:40px 70px}.final h2{font-size:33px}.actions{gap:22px}.platforms{font-size:10px}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.np-page *{transition:none!important}}
</style>
