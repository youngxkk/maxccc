---
import BaseLayout from '../layouts/BaseLayout.astro';
import MainNav from '../components/MainNav.astro';
import MainFooter from '../components/MainFooter.astro';
import StoreButton from '../components/mock/StoreButton.astro';
import { pineappleContent } from '../i18n/pineapple-content';
import '../styles/product.css';
const t = (key: keyof typeof pineappleContent['zh-CN']) => pineappleContent['zh-CN'][key];
const appStoreUrl = 'https://apps.apple.com/app/id6451401303';
const shot = (name: string) => `/images/pineapple/screens/${name}.webp`;
const features = ['game', 'practice'] as const;
const growth = ['progress', 'books'] as const;
---
<BaseLayout title="菠萝英语 · 在游戏中认识世界" description="3000+ 儿童英语单词、50+ 生活主题，搭配单词连连看、听音选图、错题复习与分级词书，让英语启蒙更有趣。" canonical="https://maxc.cc/pineapple-english/" ogImage="https://maxc.cc/images/pinaappleenglish.webp" includeHomeStyles includeHomeScript>
  <script slot="head" is:inline define:vars={{ pineappleContent }}>
    for (const [lang, copy] of Object.entries(pineappleContent)) Object.assign(window.DoCoolI18n.shared[lang], copy);
  </script>
  <MainNav showSectionLinks={false} />
  <main class="pine">
    <section class="pine-hero wrap">
      <div class="hero-copy">
        <div class="brand"><img src="/images/pinaappleenglish.webp" alt="Pineapple English" width="56" height="56" /><div><strong data-i18n="pe_brand">{t('pe_brand')}</strong><small>PINEAPPLE ENGLISH</small></div></div>
        <p class="eyebrow" data-i18n="pe_tag">{t('pe_tag')}</p>
        <h1 data-i18n="pe_title" set:html={t('pe_title')} />
        <p class="lede" data-i18n="pe_intro">{t('pe_intro')}</p>
        <div class="actions"><StoreButton href={appStoreUrl} /><a href="#discover" data-i18n="pe_explore">{t('pe_explore')}</a></div>
        <p class="available" data-i18n="pe_available">{t('pe_available')}</p>
      </div>
      <div class="hero-art"><img class="collage" src={shot('collage')} alt="A colorful collection of illustrated English vocabulary cards" width="2400" height="2400" fetchpriority="high" /><div class="hero-phone device"><img src={shot('topics')} alt="Pineapple English topics: animals, fruits and colors" width="1242" height="2688" fetchpriority="high" /></div></div>
    </section>
    <div class="stats wrap"><div><strong>3000<span>+</span></strong><p data-i18n="pe_words_stat">{t('pe_words_stat')}</p></div><div><strong>50<span>+</span></strong><p data-i18n="pe_topics_stat">{t('pe_topics_stat')}</p></div><div><strong>Look. Listen. Play.</strong><p data-i18n="pe_play_stat">{t('pe_play_stat')}</p></div></div>
    <section class="discovery wrap" id="discover">
      <div class="section-head"><p class="eyebrow" data-i18n="pe_world_label">{t('pe_world_label')}</p><h2 data-i18n="pe_world_title" set:html={t('pe_world_title')} /><p data-i18n="pe_world_desc">{t('pe_world_desc')}</p></div>
      <div class="discovery-grid"><div class="topic-art"><div class="tablet"><img src={shot('ipad-topics')} alt="Everyday topic collections on iPad" width="1637" height="2183" loading="lazy" /></div></div><article class="word-card"><div><span class="mini-label">A → Z</span><h3 data-i18n="pe_cards_title">{t('pe_cards_title')}</h3><p data-i18n="pe_cards_desc">{t('pe_cards_desc')}</p></div><div class="device"><img src={shot('words')} alt="Fruit vocabulary cards with pictures and words" width="1242" height="2688" loading="lazy" /></div></article></div>
    </section>
    <section class="play"><div class="wrap"><div class="section-head"><p class="eyebrow" data-i18n="pe_play_label">{t('pe_play_label')}</p><h2 data-i18n="pe_play_title" set:html={t('pe_play_title')} /><p data-i18n="pe_play_desc">{t('pe_play_desc')}</p></div><div class="play-grid">{features.map((name,i)=><article><div class="feature-copy"><span class="number">0{i+1}</span><h3 data-i18n={`pe_${name}_title`}>{t(`pe_${name}_title`)}</h3><p data-i18n={`pe_${name}_desc`}>{t(`pe_${name}_desc`)}</p></div><div class="shot-stage"><div class="device"><img src={shot(i===0?'games':'practice')} alt={i===0?'Word matching game':'Listen and choose the correct picture'} width="1242" height="2688" loading="lazy" /></div></div></article>)}</div></div></section>
    <section class="growth wrap"><div class="section-head"><p class="eyebrow" data-i18n="pe_grow_label">{t('pe_grow_label')}</p><h2 data-i18n="pe_grow_title" set:html={t('pe_grow_title')} /></div><div class="growth-grid">{growth.map(name=><article><div class="device"><img src={shot(name)} alt={name==='books'?'Choose a themed, CEFR or Cambridge wordbook':'Learning progress and vocabulary statistics'} width="1242" height="2688" loading="lazy" /></div><div><span class="mini-label">{name==='books'?'YOUR OWN PACE':'LITTLE WINS'}</span><h3 data-i18n={`pe_${name}_title`}>{t(`pe_${name}_title`)}</h3><p data-i18n={`pe_${name}_desc`}>{t(`pe_${name}_desc`)}</p></div></article>)}</div></section>
    <section class="ipad wrap"><div><p class="eyebrow">HELLO, BIG WORLD.</p><h2 data-i18n="pe_ipad_title" set:html={t('pe_ipad_title')} /><p data-i18n="pe_ipad_desc">{t('pe_ipad_desc')}</p></div><div class="tablet"><img src={shot('ipad-words')} alt="Illustrated English vocabulary on iPad" width="1637" height="2183" loading="lazy" /></div></section>
    <section class="download"><div class="wrap"><img src="/images/pinaappleenglish.webp" alt="Pineapple English" width="84" height="84" /><h2 data-i18n="pe_download_title">{t('pe_download_title')}</h2><p data-i18n="pe_download_desc">{t('pe_download_desc')}</p><StoreButton href={appStoreUrl} /><a class="privacy" href="/privacy-policy/" data-i18n="privacy_policy">隐私政策</a></div></section>
  </main>
  <MainFooter />
</BaseLayout>
<style>
  :global(html:has(.pine)) { background:#fffdf6; }
  :global(body:has(.pine)) { --bg-color:#fffdf6; --text-primary:#30412d; --text-secondary:#737969; --border-color:#efe8d6; --nav-bg:#fffdf6f0; --nav-border:#efe8d6; color-scheme:light; margin:0; background:#fffdf6!important; color:#30412d!important; }
  :global(body:has(.pine) .theme-toggle) { display:none!important; }
  :global(body:has(.pine) .lang-dropdown) { box-shadow:0 18px 40px rgba(0,0,0,.1); }
  :global(body:has(.pine) .lang-dropdown :is(button,a):hover) { background:rgba(0,0,0,.05); }
  :global(body:has(.pine) > nav) { border-color:#efe8d6!important; color:#30412d!important; }
  :global(body:has(.pine) > nav::before) { background:#fffdf6f0!important; }
  :global(body:has(.pine) > footer) { background:#faf5e8!important; color:#737969!important; }
  .pine {
    --ink: #30412d;
    --muted: #737969;
    --green: #527546;
    --cream: #fffdf6;
    background: var(--cream);
    color: var(--ink);
    font-family: ui-rounded, "SF Pro Rounded", -apple-system, "PingFang SC", sans-serif;
    overflow: clip;
    padding-top: 48px;
  }

  .pine *, .pine :global(.pp-store) { box-sizing: border-box; min-width: 0; }
  .pine h1, .pine h2, .pine h3, .pine p { margin: 0; }
  .pine h1, .pine h2, .pine h3 {
    color: var(--ink);
    font-weight: 750;
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  .pine p { color: var(--muted); font-size: 16px; line-height: 1.85; }
  .pine a { text-decoration: none; }
  .pine img { max-width: 100%; }
  .wrap { width: min(1120px, calc(100% - 80px)); margin-inline: auto; }

  /* A single left edge connects the brand, headline, description and actions. */
  .pine-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding-block: 88px 80px;
  }
  .hero-copy { text-align: left; }
  .brand { display: flex; gap: 12px; align-items: center; margin-bottom: 36px; }
  .brand img { width: 48px; height: 48px; border-radius: 13px; }
  .brand strong { display: block; font-size: 20px; line-height: 1.4; font-weight: 750; }
  .brand small { display: block; margin-top: 3px; font-size: 9px; letter-spacing: 1.8px; color: var(--muted); }
  .pine .eyebrow { font-size: 11px; line-height: 1.6; font-weight: 700; letter-spacing: 1.4px; color: var(--green); }
  .pine h1 { font-size: clamp(38px, 4.1vw, 56px); line-height: 1.28; margin-block: 16px 22px; }
  .pine :global(h1 span) { color: #d89616; }
  .pine .lede { max-width: 420px; font-size: 16px; line-height: 1.9; text-wrap: pretty; }
  .actions { display: flex; align-items: center; gap: 24px; margin-top: 30px; flex-wrap: wrap; }
  .actions > a { font-size: 13px; color: var(--green); font-weight: 650; }
  .actions > a:hover { color: var(--ink); }
  .pine .available { margin-top: 19px; font-size: 11px; line-height: 1.5; }

  /* The orange base stays visible until the button is pressed. */
  .pine :global(.pp-store) {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    height: 52px;
    padding: 0 24px;
    border: 0;
    border-radius: 17px;
    background: linear-gradient(180deg, #f9ce37 0%, #f8b731 50%, #f2a034 100%);
    color: #fff;
    font-size: 16px;
    font-weight: 750;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 5px 0 #dc8529;
    transform: translateY(0);
    transition: transform 120ms ease, box-shadow 120ms ease, filter 120ms ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .pine :global(.pp-store:hover) { opacity: 1; filter: brightness(1.035); transform: translateY(-1px); box-shadow: 0 6px 0 #dc8529; }
  .pine :global(.pp-store:active) { transform: translateY(4px); box-shadow: 0 1px 0 #dc8529; filter: brightness(.99); }
  .pine :global(.pp-store svg) { width: 20px; height: 20px; fill: currentColor; margin: 0; }
  .pine a:focus-visible, .pine :global(.pp-store:focus-visible) { outline: 3px solid #527546; outline-offset: 7px; }

  .hero-art { position: relative; height: 530px; isolation: isolate; }
  .hero-art::before {
    content: "";
    position: absolute;
    inset: 35px -15px 20px 10px;
    border-radius: 48% 48% 43% 45%;
    background: #fff0bb;
    z-index: -1;
  }
  .collage { position: absolute; height: auto; width: 69%; left: 0; top: 102px; border: 8px solid #fff; border-radius: 21px; transform: rotate(-6deg); box-shadow: 0 12px 35px #67623b15; }
  .device { width: 240px; flex-shrink: 0; border: 5px solid #394137; border-radius: 35px; overflow: hidden; background: #f3f4f8; box-shadow: 0 15px 35px #35432b14; }
  .device img, .tablet img { display: block; width: 100%; height: auto; }
  .hero-phone { position: absolute; right: 12px; top: 12px; width: 224px; transform: rotate(5deg); }
  .stats { display: grid; grid-template-columns: 1fr 1fr 1.25fr; gap: 24px; padding-block: 28px; border-block: 1px solid #e8e8da; }
  .stats > div { padding-left: 34px; border-left: 1px solid #e8e8da; }
  .stats > div:first-child { border: 0; padding-left: 0; }
  .stats strong { font-size: 32px; letter-spacing: -1px; font-weight: 750; line-height: 1.25; }
  .stats strong span { color: #d99a20; }
  .stats > div:last-child strong { font-size: 25px; letter-spacing: -.7px; }
  .stats p { margin-top: 6px; font-size: 12px; }

  /* Repeating heading widths and spacing give each chapter the same rhythm. */
  .section-head { max-width: 660px; margin: 0 auto 44px; text-align: center; }
  .pine h2 { font-size: clamp(30px, 3.3vw, 42px); line-height: 1.35; margin-block: 14px 18px; }
  .section-head > p:last-child { max-width: 570px; margin-inline: auto; }
  .pine h3 { font-size: 26px; line-height: 1.45; margin-block: 12px; }
  .discovery, .growth { padding-block: 96px; }
  .discovery-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .topic-art { display: grid; place-items: center; padding: 44px 64px; border-radius: 28px; background: #eaf0e2; }
  .tablet { border: 7px solid #394137; border-radius: 24px; overflow: hidden; background: #f3f4f8; box-shadow: 0 15px 35px #35432b14; }
  .word-card { padding: 34px 36px 0; border-radius: 28px; background: #fff0c5; overflow: hidden; }
  .mini-label { font-size: 10px; letter-spacing: 1.4px; font-weight: 700; color: var(--green); }
  .word-card p { font-size: 14px; line-height: 1.85; }
  .word-card .device { width: 205px; margin: 30px auto -95px; }
  .play { padding-block: 80px; background: #f0f3e9; }
  .play-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .play-grid article { display: flex; flex-direction: column; background: var(--cream); border-radius: 28px; overflow: hidden; }
  .feature-copy { padding: 32px 36px 0; }
  .number { font-size: 11px; letter-spacing: 1.5px; color: #8a947e; }
  .feature-copy p { font-size: 14px; }
  .shot-stage { display: flex; justify-content: center; margin-top: auto; padding-top: 32px; }
  .shot-stage .device { width: 236px; margin-bottom: -85px; }

  /* Give the copy its own full-width area; screenshots never squeeze the text. */
  .growth-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .growth-grid article { display: flex; flex-direction: column-reverse; gap: 28px; align-items: center; padding: 34px 36px 0; border: 1px solid #e7e9dd; border-radius: 28px; overflow: hidden; }
  .growth-grid article > div:last-child { width: 100%; }
  .growth-grid h3 { font-size: 25px; }
  .growth-grid p { font-size: 14px; }
  .growth-grid .device { width: 210px; margin-top: auto; margin-bottom: -72px; }
  .ipad { display: grid; grid-template-columns: 1fr 1fr; gap: 96px; align-items: center; padding: 0 60px 100px; }
  .ipad > div:first-child { max-width: 400px; }
  .ipad .tablet { width: min(100%, 310px); justify-self: center; }
  .download { padding-block: 64px 68px; text-align: center; background: #fff0be; }
  .download img { border-radius: 20px; width: 72px; height: 72px; margin-bottom: 8px; }
  .download h2 { font-size: 36px; margin-block: 12px 14px; }
  .download p { margin-bottom: 28px; }
  .download .privacy { display: block; width: fit-content; margin: 26px auto 0; font-size: 11px; color: var(--muted); }

  @media (max-width: 1000px) {
    .wrap { width: calc(100% - 56px); }
    .pine-hero { gap: 32px; padding-block: 64px; }
    .pine h1 { font-size: 42px; }
    .hero-art { height: 475px; }
    .hero-phone { width: 200px; right: 0; }
    .collage { top: 115px; width: 72%; }
    .brand { margin-bottom: 28px; }
    .actions { gap: 20px; }
    .topic-art { padding-inline: 42px; }
    .word-card, .feature-copy { padding-inline: 28px; }
    .growth-grid article { padding-inline: 28px; }
    .ipad { padding-inline: 20px; gap: 60px; }
  }

  @media (max-width: 760px) {
    .wrap { width: calc(100% - 40px); }
    .pine-hero { grid-template-columns: 1fr; gap: 36px; padding-block: 40px 36px; }
    .hero-copy { max-width: 510px; }
    .brand { margin-bottom: 28px; }
    .brand strong { font-size: 18px; }
    .brand img { width: 44px; height: 44px; }
    .pine h1 { font-size: clamp(35px, 6.4vw, 46px); margin-block: 14px 18px; }
    .pine .lede { max-width: 440px; font-size: 15px; }
    .actions { margin-top: 24px; gap: 22px; }
    .pine .available { margin-top: 17px; }
    .hero-art { width: min(390px, 100%); height: 450px; margin-inline: auto; }
    .hero-art::before { inset: 20px 0; }
    .hero-phone { width: 193px; top: 8px; right: 15px; }
    .collage { width: 66%; top: 100px; left: 5px; }
    .stats { gap: 12px; padding-block: 23px; }
    .stats > div { padding-left: 16px; }
    .stats strong { font-size: 26px; }
    .stats > div:last-child strong { display: block; font-size: 18px; max-width: 110px; }
    .stats p { font-size: 10px; line-height: 1.65; }
    .discovery, .growth { padding-block: 64px; }
    .section-head { text-align: left; margin-bottom: 30px; }
    .section-head > p:last-child { margin-inline: 0; }
    .pine h2 { font-size: 31px; margin-block: 12px 16px; }
    .section-head p, .ipad p { font-size: 14px; }
    .discovery-grid, .play-grid, .growth-grid, .ipad { grid-template-columns: 1fr; gap: 20px; }
    .topic-art { padding: 32px 65px; }
    .topic-art .tablet { max-width: 280px; }
    .word-card { padding: 28px 26px 0; }
    .pine h3 { font-size: 24px; }
    .word-card .device { width: 210px; margin-top: 26px; }
    .play { padding-block: 60px; }
    .feature-copy { padding: 28px 26px 0; }
    .shot-stage .device { width: 220px; }
    .growth-grid article { padding: 28px 26px 0; gap: 26px; }
    .growth-grid .device { width: 210px; }
    .ipad { padding: 0 0 64px; gap: 30px; }
    .ipad .tablet { width: 260px; }
    .download { padding-block: 48px 52px; }
    .download h2 { font-size: 29px; }
    .download p { font-size: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pine :global(.pp-store) { transition: none; }
  }
</style>
