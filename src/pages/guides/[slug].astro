---
import DiscoveryLayout from '../../layouts/DiscoveryLayout.astro';
import { guides } from '../../data/guides';
import { productSeo } from '../../data/product-seo';
export function getStaticPaths() { return guides.map(guide => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide } = Astro.props;
const product = productSeo[guide.product];
const url = `https://maxc.cc/guides/${guide.slug}/`;
const schema = { '@context': 'https://schema.org', '@type': 'Article', headline: guide.title, description: guide.description, mainEntityOfPage: url, inLanguage: 'zh-CN', author: { '@id': 'https://maxc.cc/#organization' }, about: { '@id': `https://maxc.cc/${guide.product}/#application` } };
---
<DiscoveryLayout title={`${guide.title} | invisilab`} description={guide.description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <nav aria-label="面包屑"><a href="/">invisilab</a><span>/</span><a href="/guides/">使用指南</a></nav>
  <article>
    <h1>{guide.title}</h1><p>{guide.description}</p>
    {guide.sections.map(([heading, body]) => <section><h2>{heading}</h2><p>{body}</p></section>)}
  </article>
  <section><h2>了解 {product.name}</h2><p>{product.description}</p><p><a href={`/${guide.product}/`}>查看功能和界面 →</a></p><a href={`https://apps.apple.com/app/id${product.store}`} target="_blank" rel="noopener noreferrer">在 App Store 查看 {product.name} ↗</a></section>
  <nav aria-label="更多指南"><a href="/guides/">所有指南</a><a href="/apps/">所有应用</a></nav>
</DiscoveryLayout>
