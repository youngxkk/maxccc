---
import ProductDetails from "../components/ProductDetails.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import MainNav from '../components/MainNav.astro';
import MainFooter from '../components/MainFooter.astro';
import StoreButton from '../components/mock/StoreButton.astro';
import { pixieContent } from '../i18n/pixie-content';
import { wallpapers, pixieImage } from '../data/pixie-wallpapers';
const appStoreUrl = 'https://apps.apple.com/app/id6446266063';
const t = (key: keyof typeof pixieContent['zh-CN']) => pixieContent['zh-CN'][key];
const hero = [wallpapers[2], wallpapers[1], wallpapers[0], wallpapers[3], wallpapers[5]];
const categories = ['all', 'nature', 'minimal', 'art', 'fun', 'portrait'];
---
<BaseLayout title="精灵壁纸 Pixie — 每次亮屏，一眼心动" description="每日更新的精选壁纸，风景、极简、趣味插画与更多风格。收藏心动，通过 iCloud 同步。为 iPhone 和 iPad 找到下一张喜欢的壁纸。" canonical="https://maxc.cc/pixie-wallpaper" ogImage="https://maxc.cc/images/pixie/113-1726-imgPixie1.webp" includeHomeStyles includeHomeScript>
  <script slot="head" is:inline define:vars={{ pixieContent }}>
    for (const [lang, copy] of Object.entries(pixieContent)) if (window.DoCoolI18n.shared[lang]) Object.assign(window.DoCoolI18n.shared[lang], copy);
  </script>
  <MainNav showSectionLinks={false} />
  <div class="pixie-page">
    <main>
      <section class="pixie-hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="pixie-brand">
            <img src="/images/pixie/app-icon.webp" alt="精灵壁纸 Pixie 应用图标" width="72" height="72" loading="eager" />
            <span>精灵壁纸</span>
          </div>
          <p class="eyebrow"><span class="sparkle" aria-hidden="true">✧</span><span data-i18n="pxw_eyebrow">{t('pxw_eyebrow')}</span></p>
          <h1 id="hero-title"><span data-i18n="pxw_title1">{t('pxw_title1')}</span><span class="copper" data-i18n="pxw_title2">{t('pxw_title2')}</span></h1>
          <p class="hero-lede" data-i18n="pxw_lede">{t('pxw_lede')}</p>
          <div class="download-actions"><StoreButton href={appStoreUrl} /></div>
        </div>
        <div class="hero-wallpapers" aria-label="精选壁纸预览">
          {hero.map((wallpaper, index) => <button class:list={['hero-phone', `phone-${index}`, {'main-phone': index === 2}]} data-wallpaper={wallpaper.src} aria-label={wallpaper.alt}>
            <img src={wallpaper.src} alt={wallpaper.alt} width="360" height="780" loading="eager" decoding="async" fetchpriority={index === 2 ? 'high' : 'auto'} />
            <span class="island" aria-hidden="true"></span>
            <span class="lock-screen" aria-hidden="true"><span class="lock-date">Wednesday, October 28</span><span class="lock-time">9:41</span></span>
            <span class="phone-bottom" aria-hidden="true"></span>
          </button>)}
          <span class="hero-floor" aria-hidden="true"></span>
        </div>
        <a href="#wallpapers" class="scroll-cue"><span data-i18n="pxw_scroll">{t('pxw_scroll')}</span><span aria-hidden="true">↓</span></a>
      </section>
      <div class="promise-strip">
        {['daily','picked','sync'].map((item, i) => <div><span class="promise-icon" aria-hidden="true">{['↻','✧','☁'][i]}</span><span><strong data-i18n={`pxw_${item}`}>{t(`pxw_${item}` as keyof typeof pixieContent['zh-CN'])}</strong><small data-i18n={`pxw_${item}_sub`}>{t(`pxw_${item}_sub` as keyof typeof pixieContent['zh-CN'])}</small></span></div>)}
      </div>
      <section class="gallery-section section-shell" id="wallpapers" aria-labelledby="gallery-title">
        <div class="section-heading"><p class="eyebrow" data-i18n="pxw_gallery_kicker">{t('pxw_gallery_kicker')}</p><h2 id="gallery-title" data-i18n="pxw_gallery_title">{t('pxw_gallery_title')}</h2><p data-i18n="pxw_gallery_desc">{t('pxw_gallery_desc')}</p></div>
        <div class="gallery-toolbar"><div class="filter-list" role="group" aria-label="壁纸风格">{categories.map((category, i) => <button class:list={['filter', {active: i===0}]} data-filter={category} aria-pressed={i===0} data-i18n={`pxw_${category}`}>{t(`pxw_${category}` as keyof typeof pixieContent['zh-CN'])}</button>)}</div><span class="preview-hint" data-i18n="pxw_preview_hint">{t('pxw_preview_hint')}</span></div>
        <div class="wallpaper-grid">
          {wallpapers.map((wallpaper, i) => <button class:list={['wallpaper-card', {'gallery-extra': i >= 12}]} data-category={wallpaper.category} data-wallpaper={wallpaper.src} aria-label={wallpaper.alt}>
            <img src={wallpaper.src} alt={wallpaper.alt} width="380" height="610" loading="lazy" decoding="async" />
            <span class="card-overlay"><span>PIXIE / {String(i+1).padStart(2,'0')}</span><span aria-hidden="true">↗</span></span>
          </button>)}
        </div>
        <div class="gallery-bottom"><button class="show-more"><span data-i18n="pxw_more">{t('pxw_more')}</span><span aria-hidden="true">＋</span></button><a href={appStoreUrl} target="_blank" rel="noopener noreferrer" class="gallery-store">App Store <span aria-hidden="true">↗</span></a></div>
      </section>
      <section class="features section-shell" id="features" aria-label="Pixie 功能">
        <article class="feature-row">
          <div class="feature-copy"><p class="eyebrow" data-i18n="pxw_fresh_kicker">{t('pxw_fresh_kicker')}</p><h2 data-i18n="pxw_fresh_title">{t('pxw_fresh_title')}</h2><p data-i18n="pxw_fresh_desc">{t('pxw_fresh_desc')}</p><span class="feature-tag"><span aria-hidden="true">✧</span><span data-i18n="pxw_fresh_tag">{t('pxw_fresh_tag')}</span></span></div>
          <div class="feature-art fresh-art"><span class="art-word" aria-hidden="true">Every day.</span><div class="daily-phone screenshot-phone"><img src={pixieImage('113-1059-imgSimulatorScreenshotIPhone17Pro20260809At2128011')} alt="精灵壁纸每日精选的真实 iPhone 界面" width="1206" height="2622" loading="lazy" /></div><img class="floating-wallpaper float-one" src={wallpapers[34].src} alt="" width="150" height="240" loading="lazy" /><img class="floating-wallpaper float-two" src={wallpapers[7].src} alt="" width="150" height="240" loading="lazy" /></div>
        </article>
        <article class="feature-row reverse">
          <div class="feature-copy"><p class="eyebrow" data-i18n="pxw_save_kicker">{t('pxw_save_kicker')}</p><h2 data-i18n="pxw_save_title">{t('pxw_save_title')}</h2><p data-i18n="pxw_save_desc">{t('pxw_save_desc')}</p><span class="feature-tag"><span aria-hidden="true">♡</span><span data-i18n="pxw_save_tag">{t('pxw_save_tag')}</span></span></div>
          <div class="feature-art save-art"><span class="sync-orbit" aria-hidden="true"></span><span class="cloud-badge" aria-hidden="true">☁ <small>iCloud</small></span><div class="save-phone screenshot-phone"><img src={pixieImage('113-1279-imgSimulatorScreenshotIPhone17Pro20260809At2128011')} alt="精灵壁纸收藏与 iCloud 同步的真实界面" width="1206" height="2622" loading="lazy" /></div><span class="favorite-badge" aria-hidden="true">♥</span></div>
        </article>
      </section>
      <section class="devices-section section-shell" id="devices" aria-labelledby="devices-title">
        <div class="section-heading"><p class="eyebrow" data-i18n="pxw_devices_kicker">{t('pxw_devices_kicker')}</p><h2 id="devices-title" data-i18n="pxw_devices_title">{t('pxw_devices_title')}</h2><p data-i18n="pxw_devices_desc">{t('pxw_devices_desc')}</p></div>
        <div class="device-stage">
          <div class="tablet"><img src={pixieImage('113-1607-imgSimulatorScreenshotIPadPro13InchM520260809At2132173')} alt="精灵壁纸 iPad 浏览界面" width="2064" height="2752" loading="lazy" /></div>
          <div class="device-phone screenshot-phone"><img src={pixieImage('113-1059-imgSimulatorScreenshotIPhone17Pro20260809At2128011')} alt="精灵壁纸 iPhone 浏览界面" width="1206" height="2622" loading="lazy" /></div>
          <div class="device-caption"><span aria-hidden="true">✧</span><span data-i18n="pxw_devices_tag">{t('pxw_devices_tag')}</span></div>
        </div>
      </section>
      <section class="final-section">
        <img class="brand-background" src={pixieImage('113-1726-imgPixie1')} alt="" width="1920" height="1080" loading="lazy" />
        <div class="final-copy"><img class="final-icon" src="/images/pixie.webp" width="72" height="72" alt="精灵壁纸" /><p class="eyebrow">PIXIE WALLPAPER</p><h2 data-i18n="pxw_last_title">{t('pxw_last_title')}</h2><p data-i18n="pxw_last_desc">{t('pxw_last_desc')}</p><StoreButton href={appStoreUrl} /><small data-i18n="pxw_note">{t('pxw_note')}</small></div>
      </section>
      <ProductDetails slug="pixie-wallpaper" />
  </main>
    <dialog class="wallpaper-dialog" aria-labelledby="preview-title">
      <div class="dialog-heading"><span id="preview-title" data-i18n="pxw_preview">{t('pxw_preview')}</span><button class="close-preview" autofocus><span data-i18n="pxw_close">{t('pxw_close')}</span><span aria-hidden="true">×</span></button></div>
      <img class="preview-image" alt="" width="600" height="1200" />
      <div class="dialog-footer"><p data-i18n="pxw_preview_cta">{t('pxw_preview_cta')}</p><StoreButton href={appStoreUrl} /></div>
    </dialog>
  </div>
  <MainFooter />
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.wallpaper-dialog')!;
  const preview = dialog.querySelector<HTMLImageElement>('.preview-image')!;
  let trigger: HTMLElement | null = null;
  document.querySelectorAll<HTMLButtonElement>('[data-wallpaper]').forEach(button => {
    button.addEventListener('click', () => {
      trigger = button;
      preview.src = button.dataset.wallpaper!;
      preview.alt = button.getAttribute('aria-label') || '';
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    });
  });
  dialog.querySelector('.close-preview')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
  dialog.addEventListener('close', () => { document.body.style.overflow = ''; trigger?.focus(); });
  const grid = document.querySelector('.wallpaper-grid')!;
  const more = document.querySelector<HTMLButtonElement>('.show-more')!;
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => {
    const category = button.dataset.filter;
    document.querySelectorAll('[data-filter]').forEach(filter => { const active = filter === button; filter.classList.toggle('active', active); filter.setAttribute('aria-pressed', String(active)); });
    grid.classList.toggle('filtered', category !== 'all');
    document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(card => card.hidden = category !== 'all' && card.dataset.category !== category);
    more.hidden = category !== 'all' || grid.classList.contains('expanded');
  }));
  more.addEventListener('click', () => { grid.classList.add('expanded'); more.hidden = true; });
</script>

<style>
  :global(html:has(.pixie-page)) { scroll-behavior: smooth; scroll-padding-top: 145px; background: #08090b; }
  :global(body:has(.pixie-page)) { --bg-color:#08090b; --text-primary:#f4f2ef; --text-secondary:#99999f; --border-color:rgba(255,255,255,.09); --nav-bg:rgba(8,9,11,.88); --nav-border:rgba(255,255,255,.08); color-scheme:dark; margin:0; background:#08090b!important; color:#f4f2ef!important; }
  :global(body:has(.pixie-page) .theme-toggle) { display:none!important; }
  :global(body:has(.pixie-page) .lang-dropdown :is(button,a):hover) { background:rgba(255,255,255,.1); }
  :global(body:has(.pixie-page) > nav) { background:transparent!important; color:#efefef; border-color:rgba(255,255,255,.08)!important; }
  :global(body:has(.pixie-page) > nav::before) { background:rgba(8,9,11,.88)!important; }
  :global(body:has(.pixie-page) > footer) { background:#08090b!important; color:#929295!important; }
  .pixie-page { --copper:#edba93; --muted:#99999f; font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','PingFang SC',sans-serif; background:#08090b; color:#f4f2ef; overflow:clip; padding-top:48px; }
  .pixie-page :is(h1,h2,h3,p) { margin:0; }
  .pixie-page a { color:inherit; text-decoration:none; }
  .pixie-page button { font:inherit; color:inherit; cursor:pointer; }
  .pixie-page button:focus-visible,.pixie-page a:focus-visible { outline:2px solid var(--copper); outline-offset:6px; }
  .product-nav { height:66px; padding:0 max(5vw,calc((100vw - 1260px)/2)); display:flex; align-items:center; justify-content:space-between; gap:24px; border-bottom:1px solid #ffffff12; position:sticky; top:48px; z-index:20; background:#08090be8; backdrop-filter:blur(24px); }
  .product-brand { display:flex; gap:10px; align-items:center; font-size:14px; font-weight:600; white-space:nowrap; }
  .product-brand img { border-radius:8px; }
  .brand-divider { color:#535356; margin:0 3px; font-weight:300; }
  .brand-pixie { font:italic 20px Georgia,serif; color:var(--copper); }
  .product-links { display:flex; gap:30px; color:#b4b2b0; font-size:12px; }
  .product-links a:hover,.text-link:hover { color:var(--copper); }
  .nav-download { border:1px solid #e5b58c66; border-radius:30px; padding:9px 17px; font-size:12px; white-space:nowrap; }
  .nav-download span { margin-left:12px; color:var(--copper); }
  .pixie-hero { position:relative; padding:45px 0 26px; text-align:center; background:radial-gradient(ellipse 60% 38% at 50% 72%,#272d3826,transparent); }
  .hero-copy { position:relative; z-index:2; padding:0 24px; }
  .pixie-brand { display:flex; align-items:center; justify-content:center; gap:16px; margin-bottom:26px; }
  .pixie-brand img { width:72px; height:72px; border-radius:17px; border:1px solid #ffffff1a; }
  .pixie-brand span { color:#f1d3b5; font-size:26px; font-weight:600; letter-spacing:.06em; }
  .eyebrow { display:flex; align-items:center; justify-content:center; gap:9px; color:var(--copper); font-size:11px; letter-spacing:.2em; font-weight:500; }
  .sparkle { font-size:20px; }
  h1 { font-size:clamp(46px,5.1vw,74px); line-height:1.18; letter-spacing:-.065em; font-weight:650; margin-top:22px!important; }
  h1 > span { display:inline-block; }
  h1 > span + span { margin-left:.12em; }
  .copper { background:linear-gradient(110deg,#f5dfc8,#d99169 65%,#e9c9ae); background-clip:text; -webkit-text-fill-color:transparent; }
  .hero-lede { white-space:pre-line; font-size:16px; line-height:1.9; color:#aaa8a6; margin-top:25px!important; }
  .download-actions { display:flex; align-items:center; justify-content:center; gap:26px; margin-top:30px; margin-bottom:36px; }
  .pixie-page :global(.pp-store) { display:inline-flex; align-items:center; justify-content:center; gap:9px; border:1px solid #f4d6b8; border-radius:100px; padding:14px 23px; background:linear-gradient(110deg,#f5d9ba,#e7ae83); color:#21180f; font-size:13px; font-weight:650; box-shadow:0 4px 26px #d7996415; transition:transform .2s,box-shadow .2s; }
  .pixie-page :global(.pp-store:hover) { transform:translateY(-2px); box-shadow:0 6px 30px #d7996430; }
  .pixie-page :global(.pp-store svg) { width:21px; height:21px; fill:currentColor; }
  .text-link { display:flex; gap:12px; align-items:center; font-size:12px; color:#ceccca!important; }
  .hero-wallpapers { display:flex; justify-content:center; align-items:center; gap:25px; height:510px; margin:32px auto 0; max-width:1280px; position:relative; }
  .hero-phone { flex:0 0 195px; height:396px; padding:5px; position:relative; border:1px solid #ffffff2a; border-radius:35px; background:#1c1d21; box-shadow:0 30px 55px #0009; overflow:hidden; transform-origin:50% 90%; transition:translate .3s; }
  .hero-phone:hover { translate:0 -12px; }
  .hero-phone img { display:block; width:100%; height:100%; object-fit:cover; border-radius:29px; }
  .hero-phone.phone-0 { transform:rotate(-13deg) translateY(35px); }
  .hero-phone.phone-1 { transform:rotate(-6deg) translateY(-5px); }
  .hero-phone.phone-2 { transform:translateY(-24px); flex-basis:230px; height:473px; z-index:3; }
  .hero-phone.phone-3 { transform:rotate(6deg) translateY(-5px); }
  .hero-phone.phone-4 { transform:rotate(13deg) translateY(35px); }
  .island { position:absolute; top:14px; left:50%; transform:translateX(-50%); width:27%; height:18px; border-radius:30px; background:#080808; }
  .lock-screen { position:absolute; top:52px; left:0; right:0; color:white; display:flex; flex-direction:column; align-items:center; text-shadow:0 1px 12px #0002; }
  .lock-date { font-size:9px; font-weight:500; }
  .lock-time { font-size:57px; font-weight:650; letter-spacing:-.06em; line-height:1.15; }
  .main-phone .lock-time { font-size:69px; }
  .phone-0 .lock-screen { color:#45320a; text-shadow:none; }
  .phone-bottom { position:absolute; bottom:13px; left:35%; right:35%; height:3px; border-radius:4px; background:#fff9; }
  .hero-floor { position:absolute; bottom:0; left:-15%; right:-15%; height:80px; background:linear-gradient(transparent,#08090b 92%); pointer-events:none; z-index:4; }
  .scroll-cue { display:flex; flex-direction:column; align-items:center; gap:12px; color:#69696e!important; font-size:10px; letter-spacing:.12em; }
  .scroll-cue > span:last-child { font-size:18px; }
  .promise-strip { max-width:1000px; margin:28px auto 0; padding:32px 20px; display:grid; grid-template-columns:repeat(3,1fr); border-block:1px solid #ffffff12; }
  .promise-strip > div { display:flex; align-items:center; justify-content:center; gap:15px; }
  .promise-strip > div + div { border-left:1px solid #ffffff12; }
  .promise-icon { font-size:26px; color:#d3af90; font-weight:300; }
  .promise-strip strong { display:block; font-size:14px; font-weight:500; }
  .promise-strip small { display:block; color:#77777e; font-size:11px; margin-top:7px; }
  .section-shell { max-width:1180px; margin:auto; padding-inline:30px; }
  .gallery-section { padding-top:120px; }
  .section-heading { text-align:center; margin:auto; max-width:680px; }
  h2 { font-size:clamp(32px,4vw,52px); font-weight:600; letter-spacing:-.045em; line-height:1.3; white-space:pre-line; }
  .section-heading h2 { margin-top:20px!important; }
  .section-heading > p:last-child { font-size:14px; line-height:1.9; color:var(--muted); margin-top:20px; }
  .gallery-toolbar { display:flex; align-items:center; justify-content:space-between; gap:20px; margin:46px 0 28px; }
  .filter-list { display:flex; flex-wrap:wrap; gap:6px; }
  .filter { border:1px solid transparent; padding:9px 15px; background:transparent; border-radius:30px; font-size:11px!important; color:#97979d!important; transition:background .2s,color .2s; }
  .filter.active { background:#eac19c; color:#1d1711!important; }
  .filter:not(.active):hover { background:#ffffff0b; color:#fff!important; }
  .preview-hint { color:#696971; font-size:10px; white-space:nowrap; }
  .wallpaper-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:16px; }
  .wallpaper-card { padding:0; position:relative; display:block; border:0; background:#16181c; aspect-ratio:10/16; border-radius:18px; overflow:hidden; transition:transform .35s; }
  .wallpaper-card:hover { transform:translateY(-6px); }
  .wallpaper-card img { width:100%; height:100%; object-fit:cover; display:block; transition:scale .5s; }
  .wallpaper-card:hover img { scale:1.045; }
  .wallpaper-card[hidden],.gallery-extra { display:none; }
  .expanded .gallery-extra:not([hidden]),.filtered .gallery-extra:not([hidden]) { display:block; }
  .card-overlay { position:absolute; inset:60% 0 0; background:linear-gradient(transparent,#0008); display:flex; justify-content:space-between; align-items:end; padding:14px 12px; color:#fff; font-size:8px; letter-spacing:.12em; opacity:0; transition:opacity .25s; }
  .card-overlay > span:last-child { font-size:18px; }
  .wallpaper-card:hover .card-overlay,.wallpaper-card:focus-visible .card-overlay { opacity:1; }
  .gallery-bottom { display:flex; align-items:center; justify-content:center; gap:24px; padding:64px 0 10px; }
  .show-more { display:flex; gap:24px; align-items:center; border:1px solid #ffffff26; border-radius:30px; padding:13px 23px; font-size:12px!important; background:#ffffff05; }
  .show-more[hidden] { display:none; }
  .gallery-store { font-size:12px; color:var(--copper)!important; }
  .gallery-store span { margin-left:8px; }
  .features { padding-top:110px; }
  .feature-row { display:grid; grid-template-columns:1fr 1.1fr; align-items:center; gap:90px; padding-block:45px; }
  .feature-copy .eyebrow { justify-content:start; font-size:10px; }
  .feature-copy h2 { margin-top:26px!important; }
  .feature-copy > p:not(.eyebrow) { font-size:14px; line-height:2; color:#929299; margin-top:26px; max-width:370px; }
  .feature-tag { display:flex; gap:10px; align-items:center; margin-top:32px; font-size:11px; color:#d0b59d; }
  .feature-tag > span:first-child { font-size:24px; }
  .feature-art { position:relative; height:560px; overflow:hidden; border:1px solid #ffffff0a; border-radius:28px; background:#101216; }
  .fresh-art { background:radial-gradient(ellipse at 50% 60%,#123640,#101419 70%); }
  .art-word { position:absolute; top:30px; left:28px; font:italic 48px Georgia,serif; color:#96a6a01c; white-space:nowrap; }
  .screenshot-phone { border:7px solid #272a30; border-radius:34px; overflow:hidden; background:#000; box-shadow:0 0 0 1px #ffffff24; aspect-ratio:1206/2622; }
  .screenshot-phone img { display:block; width:100%; height:100%; object-fit:cover; }
  .daily-phone { position:absolute; display:block; height:515px; width:237px; bottom:-57px; left:50%; transform:translateX(-50%) rotate(-7deg); filter:drop-shadow(0 20px 30px #0008); }
  .floating-wallpaper { position:absolute; width:110px; height:177px; object-fit:cover; border-radius:16px; box-shadow:0 15px 25px #0006; }
  .float-one { left:-18px; bottom:43px; transform:rotate(-15deg); }
  .float-two { right:-17px; top:70px; transform:rotate(13deg); }
  .reverse .feature-copy { order:2; }
